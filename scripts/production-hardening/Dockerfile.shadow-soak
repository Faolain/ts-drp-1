FROM node:22-bookworm-slim

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /workspace

RUN corepack enable
RUN apt-get update \
    && apt-get install --yes --no-install-recommends g++ make python3 \
    && rm -rf /var/lib/apt/lists/*
RUN chown node:node /workspace
COPY --chown=node:node . .
USER node
RUN pnpm install --frozen-lockfile
RUN pnpm build:packages
RUN mkdir -p node_modules/@ts-drp \
    && ln -s ../../packages/canonical node_modules/@ts-drp/canonical \
    && ln -s ../../packages/control-plane node_modules/@ts-drp/control-plane \
    && ln -s ../../packages/message-queue node_modules/@ts-drp/message-queue \
    && ln -s ../../packages/storage node_modules/@ts-drp/storage \
    && ln -s ../../packages/types node_modules/@ts-drp/types \
    && ln -s ../../packages/protocol-v3 node_modules/@ts-drp/protocol-v3 \
    && mkdir -p node_modules/@noble \
    && ln -s ../../packages/control-plane/node_modules/@noble/curves node_modules/@noble/curves

CMD ["pnpm", "tsx", "scripts/production-hardening/run-shadow-soak.ts"]
