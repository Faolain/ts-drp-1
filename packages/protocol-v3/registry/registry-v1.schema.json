{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ts-drp.org/protocol-v3/registry-v1.schema.json",
	"title": "TS-DRP protocol v3 registry v1 kind schemas",
	"description": "Review-order schemas for every registered protocol-v3 kind; canonical object encoding orders keys by encoded key bytes.",
	"$defs": {
		"promotionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"promotionEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
		"promotionRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["digest", "byteLength"],
			"properties": {
				"digest": { "$ref": "#/$defs/promotionDigest" },
				"byteLength": { "type": "integer", "minimum": 1, "maximum": 65536 }
			}
		},
		"promotionManifestRef": {
			"type": "object",
			"additionalProperties": false,
			"required": ["digest", "byteLength"],
			"properties": {
				"digest": { "$ref": "#/$defs/promotionDigest" },
				"byteLength": { "type": "integer", "minimum": 1, "maximum": 212387 }
			}
		},
		"promotionRetirementRef": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"prefixItems": [{ "const": "drp-creator-issuance-retirement-state" }, { "$ref": "#/$defs/promotionRef" }],
			"items": false
		},
		"promotionAggregateRef": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"prefixItems": [{ "const": "drp-creator-author-issuance-frontiers-state" }, { "$ref": "#/$defs/promotionRef" }],
			"items": false
		},
		"promotionSettlementRef": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"prefixItems": [{ "const": "drp-creator-author-settlement-state" }, { "$ref": "#/$defs/promotionRef" }],
			"items": false
		},
		"promotionRetirementControls": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"prefixItems": [{ "$ref": "#/$defs/promotionRetirementRef" }],
			"items": false
		},
		"promotionAggregateControls": {
			"type": "array",
			"minItems": 2,
			"maxItems": 2,
			"prefixItems": [{ "$ref": "#/$defs/promotionRetirementRef" }, { "$ref": "#/$defs/promotionAggregateRef" }],
			"items": false
		},
		"promotionSettlementControls": {
			"type": "array",
			"minItems": 1,
			"maxItems": 1,
			"prefixItems": [{ "$ref": "#/$defs/promotionSettlementRef" }],
			"items": false
		},
		"promotionControls": {
			"oneOf": [
				{ "$ref": "#/$defs/promotionRetirementControls" },
				{ "$ref": "#/$defs/promotionAggregateControls" },
				{ "$ref": "#/$defs/promotionSettlementControls" }
			]
		},
		"promotionSource": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"closedEpoch",
				"closedAnchorDigest",
				"successorEpoch",
				"successorAnchorDigest",
				"cutValueDigest",
				"cutRef",
				"commitQcRef",
				"manifestRef",
				"payloadDigest",
				"stateDigest",
				"closedAclDigest",
				"snapshotAclDigest",
				"checkpointRepresentation",
				"checkpointRefs"
			],
			"properties": {
				"closedEpoch": { "$ref": "#/$defs/promotionEpoch" },
				"successorEpoch": { "$ref": "#/$defs/promotionEpoch" },
				"closedAnchorDigest": { "$ref": "#/$defs/promotionDigest" },
				"successorAnchorDigest": { "$ref": "#/$defs/promotionDigest" },
				"cutValueDigest": { "$ref": "#/$defs/promotionDigest" },
				"payloadDigest": { "$ref": "#/$defs/promotionDigest" },
				"stateDigest": { "$ref": "#/$defs/promotionDigest" },
				"closedAclDigest": { "$ref": "#/$defs/promotionDigest" },
				"snapshotAclDigest": { "$ref": "#/$defs/promotionDigest" },
				"cutRef": { "$ref": "#/$defs/promotionRef" },
				"commitQcRef": { "$ref": "#/$defs/promotionRef" },
				"manifestRef": { "$ref": "#/$defs/promotionManifestRef" },
				"checkpointRepresentation": { "enum": ["settlement", "aggregate-retirement", "retirement-only"] },
				"checkpointRefs": { "$ref": "#/$defs/promotionControls" }
			},
			"allOf": [
				{
					"if": { "properties": { "checkpointRepresentation": { "const": "settlement" } } },
					"then": { "properties": { "checkpointRefs": { "$ref": "#/$defs/promotionSettlementControls" } } }
				},
				{
					"if": { "properties": { "checkpointRepresentation": { "const": "aggregate-retirement" } } },
					"then": { "properties": { "checkpointRefs": { "$ref": "#/$defs/promotionAggregateControls" } } }
				},
				{
					"if": { "properties": { "checkpointRepresentation": { "const": "retirement-only" } } },
					"then": { "properties": { "checkpointRefs": { "$ref": "#/$defs/promotionRetirementControls" } } }
				}
			]
		},
		"promotionAggregateFrontiers": {
			"type": "array",
			"maxItems": 64,
			"items": {
				"type": "array",
				"minItems": 2,
				"maxItems": 2,
				"prefixItems": [
					{ "$ref": "#/$defs/promotionDigest" },
					{ "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/promotionEpoch" }] }
				],
				"items": false
			}
		},
		"promotionSettlementFrontiers": {
			"type": "array",
			"maxItems": 256,
			"items": {
				"type": "array",
				"minItems": 3,
				"maxItems": 3,
				"prefixItems": [
					{ "$ref": "#/$defs/promotionDigest" },
					{ "$ref": "#/$defs/promotionEpoch" },
					{ "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/promotionEpoch" }] }
				],
				"items": false
			}
		},
		"forwardPromotion": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "version", "genesisAnchorDigest", "source", "roles", "authorizedSuccessorAclDigest"],
			"properties": {
				"kind": { "const": "forward-historical-promotion" },
				"version": { "const": 1 },
				"genesisAnchorDigest": { "$ref": "#/$defs/promotionDigest" },
				"authorizedSuccessorAclDigest": { "$ref": "#/$defs/promotionDigest" },
				"source": { "$ref": "#/$defs/promotionSource" },
				"roles": {
					"type": "object",
					"additionalProperties": false,
					"required": ["selectedSourceCutDigest", "retainedSources", "currentControlRefs", "frontiers"],
					"properties": {
						"selectedSourceCutDigest": { "$ref": "#/$defs/promotionDigest" },
						"retainedSources": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/promotionSource" } },
						"currentControlRefs": { "$ref": "#/$defs/promotionControls" },
						"frontiers": {
							"anyOf": [
								{ "type": "null" },
								{ "$ref": "#/$defs/promotionAggregateFrontiers" },
								{ "$ref": "#/$defs/promotionSettlementFrontiers" }
							]
						}
					},
					"allOf": [
						{
							"if": { "properties": { "currentControlRefs": { "$ref": "#/$defs/promotionSettlementControls" } } },
							"then": {
								"properties": {
									"frontiers": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/promotionSettlementFrontiers" }] }
								}
							},
							"else": {
								"properties": {
									"frontiers": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/promotionAggregateFrontiers" }] }
								}
							}
						}
					]
				}
			}
		},
		"signerSet": {
			"type": "object",
			"additionalProperties": false,
			"x-domain": "ts-drp/signer-set/v3",
			"x-encoding": "canonical-array",
			"x-canonical-key-order": "encoded-key-bytes",
			"required": ["signers"],
			"properties": {
				"signers": {
					"type": "array",
					"x-registry-type": "array<{signerId:string,publicKey:string}>",
					"x-registry-constraints": {
						"uniqueBy": "signerId",
						"signerIdCharset": "unicode-scalar-excluding-controls",
						"maxSignerIdUtf16Units": 512
					}
				}
			}
		},
		"parameters": {
			"type": "object",
			"additionalProperties": false,
			"x-domain": "ts-drp/parameters/v3",
			"x-encoding": "canonical-object",
			"x-canonical-key-order": "encoded-key-bytes",
			"required": [
				"maxEpochVertices",
				"maxEpochBytes",
				"maxDependencies",
				"snapshotChunkBytes",
				"maxSnapshotBytes",
				"maxPendingEntries",
				"maxPendingBytes"
			],
			"properties": {
				"authorShareMultiplier": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 1,
						"maximum": 1000000
					},
					"minimum": 1,
					"maximum": 1000000
				},
				"maxEpochVertices": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 32,
						"maximum": 1000000
					},
					"minimum": 32,
					"maximum": 1000000
				},
				"maxEpochBytes": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 65536,
						"maximum": 1073741824
					},
					"minimum": 65536,
					"maximum": 1073741824
				},
				"maxDependencies": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 1,
						"maximum": 256
					},
					"minimum": 1,
					"maximum": 256
				},
				"snapshotChunkBytes": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 16384,
						"maximum": 1048576
					},
					"minimum": 16384,
					"maximum": 1048576
				},
				"maxSnapshotBytes": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 1048576,
						"maximum": 4294967296
					},
					"minimum": 1048576,
					"maximum": 4294967296
				},
				"maxPendingEntries": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 1,
						"maximum": 1000000
					},
					"minimum": 1,
					"maximum": 1000000
				},
				"maxPendingBytes": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 65536,
						"maximum": 1073741824
					},
					"minimum": 65536,
					"maximum": 1073741824
				}
			}
		},
		"vertex": {
			"type": "object",
			"additionalProperties": false,
			"x-domain": "ts-drp/vertex/v3",
			"x-encoding": "canonical-object",
			"x-canonical-key-order": "encoded-key-bytes",
			"required": [
				"kind",
				"protocolMajor",
				"objectId",
				"epoch",
				"anchor",
				"author",
				"authorSequence",
				"logicalTime",
				"dependencies",
				"operation"
			],
			"properties": {
				"kind": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {},
					"const": "drp-vertex"
				},
				"protocolMajor": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {},
					"const": 3
				},
				"objectId": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {
						"minimumUtf16Units": 1,
						"maximumUtf16Units": 1024
					}
				},
				"epoch": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"anchor": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32,
						"case": "lower"
					}
				},
				"author": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {
						"minimumUtf16Units": 1,
						"maximumUtf16Units": 1024
					}
				},
				"authorSequence": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0,
						"maximum": 9007199254740991,
						"initial": 0,
						"reset": "never",
						"overflow": "reject"
					},
					"minimum": 0,
					"maximum": 9007199254740991,
					"x-initial": 0,
					"x-reset": "never",
					"x-overflow": "reject"
				},
				"logicalTime": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 1
					},
					"minimum": 1
				},
				"dependencies": {
					"type": "array",
					"x-registry-type": "array<digest-hex>",
					"x-registry-constraints": {
						"minimumItems": 1,
						"unique": true
					},
					"minItems": 1,
					"uniqueItems": true
				},
				"operation": {
					"type": "object",
					"x-registry-type": "canonical-object",
					"x-registry-constraints": {}
				}
			}
		},
		"cutValue": {
			"type": "object",
			"additionalProperties": false,
			"x-domain": "ts-drp/hard-epoch-cut/v3",
			"x-encoding": "canonical-object",
			"x-canonical-key-order": "encoded-key-bytes",
			"required": [
				"kind",
				"protocolMajor",
				"encodingVersion",
				"objectId",
				"epoch",
				"previousAnchor",
				"previousCutDigest",
				"previousHistoryRoot",
				"previousHistorySize",
				"closeSetRoot",
				"closeSetCount",
				"historyRoot",
				"historySize",
				"stateDigest",
				"aclDigest",
				"snapshotManifestDigest",
				"blueprintDigest",
				"archiveIndexRoot",
				"availabilityPolicyDigest",
				"nextSignerSet",
				"parameters",
				"closeReason"
			],
			"properties": {
				"kind": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {},
					"const": "drp-hard-epoch-cut"
				},
				"protocolMajor": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {},
					"const": 3
				},
				"encodingVersion": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {},
					"const": "drp-canonical-profile-1"
				},
				"objectId": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {
						"minimumUtf16Units": 1,
						"maximumUtf16Units": 1024
					}
				},
				"epoch": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"previousAnchor": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"previousCutDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"previousHistoryRoot": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"previousHistorySize": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"closeSetRoot": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"closeSetCount": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"historyRoot": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"historySize": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"stateDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"aclDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"snapshotManifestDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"blueprintDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"archiveIndexRoot": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"availabilityPolicyDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"nextSignerSet": {
					"type": "array",
					"x-registry-type": "array<signer>",
					"x-registry-constraints": {
						"uniqueBy": "signerId"
					}
				},
				"parameters": {
					"type": "object",
					"x-registry-type": "parameters",
					"x-registry-constraints": {}
				},
				"closeReason": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {
						"maximumUtf16Units": 128
					}
				},
				"forwardPromotion": {
					"$ref": "#/$defs/forwardPromotion",
					"x-registry-type": "forward-promotion",
					"x-registry-constraints": { "schema": "forwardPromotion", "version": 1 }
				}
			}
		},
		"epochAnchor": {
			"type": "object",
			"additionalProperties": false,
			"x-domain": "ts-drp/epoch-anchor/v3",
			"x-encoding": "canonical-object",
			"x-canonical-key-order": "encoded-key-bytes",
			"required": [
				"kind",
				"protocolMajor",
				"objectId",
				"epoch",
				"previousAnchor",
				"cutDigest",
				"stateDigest",
				"aclDigest",
				"historyRoot",
				"historySize",
				"archiveIndexRoot",
				"blueprintDigest",
				"signerSetDigest",
				"parametersDigest",
				"profileDigest",
				"cryptoSuiteId"
			],
			"properties": {
				"kind": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {},
					"const": "drp-epoch-anchor"
				},
				"protocolMajor": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {},
					"const": 3
				},
				"objectId": {
					"type": "string",
					"x-registry-type": "string",
					"x-registry-constraints": {
						"minimumUtf16Units": 1,
						"maximumUtf16Units": 1024
					}
				},
				"epoch": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"previousAnchor": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"cutDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"stateDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"aclDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"historyRoot": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"historySize": {
					"type": "integer",
					"x-registry-type": "safe-integer",
					"x-registry-constraints": {
						"minimum": 0
					},
					"minimum": 0
				},
				"archiveIndexRoot": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"blueprintDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"signerSetDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
				"parametersDigest": {
					"type": "string",
					"x-registry-type": "digest-hex",
					"x-registry-constraints": {
						"bytes": 32
					}
				},
