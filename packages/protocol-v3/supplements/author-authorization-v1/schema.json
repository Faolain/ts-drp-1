{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ts-drp.dev/protocol-v3/author-authorization-v1.schema.json",
	"title": "Protocol v3 current-epoch author authorization carrier",
	"type": "object",
	"additionalProperties": false,
	"required": ["authors", "epoch", "kind", "objectId", "profileId", "protocolMajor", "version"],
	"properties": {
		"authors": {
			"type": "array",
			"minItems": 1,
			"maxItems": 64,
			"uniqueItems": true,
			"items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
			"x-ts-drp-order": "strict-ascending-unsigned-ascii"
		},
		"epoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
		"kind": { "const": "drp-author-authorization" },
		"objectId": { "type": "string", "x-ts-drp-validator": "isStorageObjectIdText" },
		"profileId": { "const": "creator-author-authorization-v1" },
		"protocolMajor": { "const": 3 },
		"version": { "const": 1 }
	}
}
