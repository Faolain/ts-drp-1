{
	"name": "@ts-drp/canonical",
	"version": "0.11.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drp-tech/ts-drp.git"
	},
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./domain-hash-stream": {
			"types": "./dist/src/domain-hash-stream.d.ts",
			"import": "./dist/src/domain-hash-stream.js"
		},
		"./resource": {
			"types": "./dist/src/resource.d.ts",
			"import": "./dist/src/resource.js"
		},
		"./encoding-capture": {
			"types": "./dist/src/encoding-capture.d.ts",
			"import": "./dist/src/encoding-capture.js"
		},
		"./exact": {
			"types": "./dist/src/exact.d.ts",
			"import": "./dist/src/exact.js"
		},
		"./instrumentation": {
			"types": "./dist/src/instrumentation.d.ts",
			"import": "./dist/src/instrumentation.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist/ node_modules/",
		"prepack": "tsc -b",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"watch": "tsc -b -w"
	},
	"dependencies": {
		"@noble/hashes": "^1.7.1"
	}
}
