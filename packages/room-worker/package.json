{
	"name": "@ts-drp/room-worker",
	"version": "0.11.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"types": "./dist/src/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./page": {
			"types": "./dist/src/page.d.ts",
			"import": "./dist/src/page.js"
		},
		"./worker": {
			"types": "./dist/src/worker.d.ts",
			"import": "./dist/src/worker.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist/ node_modules/",
		"prepack": "tsc -b tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"watch": "tsc -b tsconfig.build.json -w"
	},
	"devDependencies": {
		"typescript": "^5.7.3"
	}
}
