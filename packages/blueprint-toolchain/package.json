{
	"name": "@ts-drp/blueprint-toolchain",
	"version": "0.11.0",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drp-tech/ts-drp.git"
	},
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"bin": {
		"drp-blueprint": "./bin/drp-blueprint.mjs"
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist/ node_modules/",
		"test": "vitest run --config vitest.config.mts --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"watch": "tsc -b -w"
	},
	"dependencies": {
		"@ts-drp/blueprint-catalog": "0.11.0",
		"@ts-drp/canonical": "0.11.0",
		"@ts-drp/protocol-v3": "0.11.0",
		"@typescript-eslint/parser": "8.29.0",
		"es-module-lexer": "1.6.0",
		"esbuild": "0.25.3",
		"eslint": "9.23.0",
		"eslint-plugin-ts-drp": "0.11.0",
		"yaml": "2.8.0"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1"
	}
}
