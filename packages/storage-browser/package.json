{
	"name": "@ts-drp/storage-browser",
	"version": "0.11.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drp-tech/ts-drp.git"
	},
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!dist/tests",
		"!dist/playwright*",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./issuance": {
			"types": "./dist/src/issuance.d.ts",
			"import": "./dist/src/issuance.js"
		},
		"./issuance-maintenance": {
			"types": "./dist/src/issuance-maintenance.d.ts",
			"import": "./dist/src/issuance-maintenance.js"
		},
		"./live-journal": {
			"types": "./dist/src/live-journal.d.ts",
			"import": "./dist/src/live-journal.js"
		},
		"./seal-vote": {
			"types": "./dist/src/seal-vote.d.ts",
			"import": "./dist/src/seal-vote.js"
		},
		"./seal-evidence": {
			"types": "./dist/src/seal-evidence.d.ts",
			"import": "./dist/src/seal-evidence.js"
		},
		"./snapshot-transfer": {
			"types": "./dist/src/snapshot-transfer.d.ts",
			"import": "./dist/src/snapshot-transfer.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist/ node_modules/",
		"prepack": "tsc -b",
		"test": "pnpm --dir ../.. exec vitest run packages/storage-browser/tests --no-coverage --maxWorkers=1 --minWorkers=1",
		"typecheck": "tsc --noEmit",
		"watch": "tsc -b -w"
	},
	"dependencies": {
		"@ts-drp/canonical": "0.11.0",
		"@ts-drp/compaction": "0.11.0",
		"@ts-drp/issuance-store": "0.11.0",
		"@ts-drp/live-journal": "0.11.0",
		"@ts-drp/seal": "0.11.0",
		"@ts-drp/storage": "0.11.0"
	},
	"devDependencies": {
		"@ts-drp/keychain": "0.11.0",
		"@ts-drp/node": "0.11.0",
		"@ts-drp/protocol-v3": "0.11.0"
	}
}
