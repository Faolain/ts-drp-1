{
	"name": "@ts-drp/worker-host",
	"version": "0.11.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"types": "./dist/src/index.d.ts",
	"files": [
		"src",
		"dist",
		"!dist/test",
		"!**/*.tsbuildinfo"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		},
		"./host": {
			"types": "./dist/src/host.d.ts",
			"import": "./dist/src/host.js"
		},
		"./worker": {
			"types": "./dist/src/worker.d.ts",
			"import": "./dist/src/worker.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist/ node_modules/",
		"prepack": "tsc -b tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"watch": "tsc -b tsconfig.build.json -w"
	}
}
