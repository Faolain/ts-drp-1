	"rules": [
		{
			"id": "TAG_TABLE_EXHAUSTIVE",
			"statement": "Exactly the fifteen declared tag octets are governed, and every other initial octet is rejected."
		},
		{
			"id": "VALUE_DISPATCH_EXACT",
			"statement": "The initial tag selects exactly one payload production, which consumes bytes only according to that production."
		},
		{
			"id": "VARUINT_MINIMAL",
			"statement": "Varuints use minimal little-endian seven-bit groups with continuation bit 128 and no redundant terminal zero group."
		},
		{
			"id": "VARUINT_RANGE",
			"statement": "Varuint octet-count range is checked before minimality, while decoded-value range is checked after minimality."
		},
		{
			"id": "ZIGZAG_SAFE_INTEGER",
			"statement": "After varuint validation, safe integers map by twice n when non-negative and negative twice n minus one when negative."
		},
		{
			"id": "LENGTHS_COUNTS_VARUINT",
			"statement": "Every payload byte length and every collection or typed-array element count uses the governed varuint production."
		},
		{
			"id": "BIG_ENDIAN_NUMERICS",
			"statement": "All fixed-width scalar and typed numeric payloads place their most-significant octet first."
		},
		{
			"id": "INTEGER_BEFORE_FLOAT",
			"statement": "Every finite safe integral scalar uses the integer tag, while governed safe-integral Float64 payloads are rejected."
		},
		{
			"id": "FLOAT_FINITE",
			"statement": "Scalar Float64 values must be finite on both encoding and governed decoding."
		},
		{
			"id": "NEGATIVE_ZERO_NORMALIZE",
			"statement": "Floating negative zero normalizes to positive zero on encoding and is rejected when present in a floating payload."
		},
		{
			"id": "STRING_UTF8",
			"statement": "Strings contain Unicode scalar values and use fatal, shortest-form UTF-8 with an octet-count prefix; unavailable declared string payloads reject as UTF8_INVALID because acquisition and decoding form one validation step."
		},
		{
			"id": "STRING_UNPAIRED_SURROGATE",
			"statement": "A source string containing an unpaired UTF-16 surrogate is outside the encodable string domain."
		},
		{
			"id": "BYTES_LENGTH",
			"statement": "The bytes length is the exact number of following uninterpreted octets and is not a character count."
		},
		{
			"id": "ARRAY_DENSE",
			"statement": "Arrays contain every indexed element from zero through count minus one, in order, without holes."
		},
		{
			"id": "OBJECT_PLAIN_NULL_PROTOTYPE",
			"statement": "Only ordinary-prototype and null-prototype source objects encode, and decoded objects always have a null prototype."
		},
		{
			"id": "OBJECT_STRING_KEYS",
			"statement": "Every object key is a string encoded through the complete recursive string value production."
		},
		{
			"id": "OBJECT_DATA_PROPERTIES",
			"statement": "Objects encode own enumerable string-keyed data properties, reject symbol keys and enumerable accessors, and ignore non-enumerable strings."
		},
		{
			"id": "MAP_ENCODED_KEY_ORDER",
			"statement": "Object and map entries sort ascending by unsigned lexicographic comparison of each complete encoded key."
		},
		{
			"id": "SET_ENCODED_VALUE_ORDER",
			"statement": "Set elements sort ascending by unsigned lexicographic comparison of each complete encoded value."
		},
		{
			"id": "DUPLICATE_CANONICAL_REJECT",
			"statement": "Equal complete encoded map keys or set values are rejected on encoding and decoding."
		},
		{
			"id": "TYPED_ARRAY_WIDTH",
			"statement": "Float32, Int32 and Uint32 elements occupy four octets, while Float64 elements occupy eight octets."
		},
		{
			"id": "TYPED_ARRAY_FINITE",
			"statement": "Every floating typed-array element must be finite and must obey the governed negative-zero rule."
		},
		{
			"id": "TRAILING_REJECT",
			"statement": "A canonical input contains exactly one complete root value and no trailing octets."
		},
		{
			"id": "UNKNOWN_TAG_REJECT",
			"statement": "An initial octet not declared by the exhaustive tag table is rejected as an unknown tag."
		},
		{
			"id": "NON_MINIMAL_REJECT",
			"statement": "A non-minimal varuint is rejected wherever a signed payload, length or count consumes a varuint."
		},
		{
			"id": "RESOURCE_LIMITS",
			"statement": "Byte, depth and decoder-wide item limits use the declared defaults, root depth and container precharges."
		},
		{
			"id": "CYCLE_REJECT",
			"statement": "Encoding rejects re-entry into any value that is already active on the recursive traversal path."
		},
		{
			"id": "UNSUPPORTED_TYPE_REJECT",
			"statement": "A source value outside the declared primitive, collection, bytes and typed-array domain is rejected."
		},
		{
			"id": "DECODE_REENCODE_IDENTITY",
			"statement": "Every accepted byte string in the governed corpus decodes to a value that re-encodes to identical bytes."
		},
		{
			"id": "EXAMPLES_SUBORDINATE",
			"statement": "Binding examples test conformance but remain subordinate to the recursive productions for every combination."
		},
		{
			"id": "UNSAFE_INTEGRAL_FLOAT_UNRESOLVED",
			"statement": "Unsafe-integral scalar Float64 decoding is unresolved outside the governed corpus and is not ratified here."
		}
	],
	"workedExamples": [
