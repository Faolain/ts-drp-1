{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"composite": false,
		"baseUrl": "../..",
		"paths": {
			"@ts-drp/example-browser-network": ["examples/browser-network/src/index.ts"],
			"@ts-drp/*": ["packages/*"]
		},
		"noEmit": true
	},
	"include": ["src/**/*.ts", "e2e/**/*.ts", "playwright.config.ts", "vite.config.ts"]
}
