					{ "name": "sequence", "required": true, "type": "safe-integer" }
				]
			}
		}
	],
	"conformance": {
		"corpusVersion": "track-p2-e-message-register-v1",
		"seed": "track-p2-e-independent-seed-2026-08-13",
