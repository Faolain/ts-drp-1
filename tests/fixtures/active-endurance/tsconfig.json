{
	"extends": "../../../tsconfig.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"paths": {
			"@ts-drp/ephemeral": ["../../../packages/ephemeral/src/index.ts"],
			"@ts-drp/keychain": ["../../../packages/keychain/src/index.ts"],
			"@ts-drp/keychain/finality": ["../../../packages/keychain/src/finality.ts"],
			"@ts-drp/network": ["../../../packages/network/src/index.ts"],
			"@ts-drp/node": ["../../../packages/node/src/index.ts"],
			"@ts-drp/network/snapshot-transfer": ["../../../packages/network/src/snapshot-transfer.ts"],
			"@ts-drp/storage": ["../../../packages/storage/src/index.ts"],
			"@ts-drp/storage/*": ["../../../packages/storage/src/*.ts"]
		}
	},
	"include": [
		"./*.ts",
		"../../active-app-endurance-native.test.ts",
		"../../active-app-endurance-failures.test.ts",
		"../../active-app-continued-play-observations.test.ts",
		"../../active-app-continued-play-native.test.ts"
	],
	"exclude": ["../../../.claude", "../../../.logs", "../../../node_modules"]
}
