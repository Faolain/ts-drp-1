						"id": "anti-copy-sequence",
						"request": {
							"kind": "vertex"
						}
					},
					{
						"id": "anti-copy-anchor",
						"request": {
							"kind": "roundChange"
						}
					},
					{
						"id": "anti-copy-context",
						"request": {
							"key": "context",
							"kind": "state"
						}
					},
					{
						"id": "anti-copy-domain",
						"request": {
							"candidateDomain": "ts-drp/vertex/v2",
							"expectedDomain": "ts-drp/vertex/v3",
							"expectedMajor": 3,
							"kind": "vertex"
						}
					},
					{
						"id": "cross-major-domain-v3-on-v2",
						"request": {
							"candidateDomain": "ts-drp/vertex/v3",
							"expectedDomain": "ts-drp/vertex/v2",
							"expectedMajor": 2,
							"kind": "vertex"
						}
					},
					{
						"id": "anti-copy-suite",
						"request": {
							"candidateSuite": "ed25519-sha256-v1",
							"expectedMajor": 3,
							"expectedSuite": "ed25519-sha256-v3",
							"kind": "vertex"
						}
					},
					{
						"id": "cross-major-suite-v3-on-v2",
						"request": {
							"candidateSuite": "ed25519-sha256-v3",
							"expectedMajor": 2,
							"expectedSuite": "ed25519-sha256-v1",
							"kind": "vertex"
						}
					}
				]
			},
			"issue-next": {
				"caseFields": ["id", "request"],
				"requestFields": ["before", "candidate", "publicKeyHex"],
				"optionalRequestFields": ["privateKeyHex"],
				"inputOnlyExample": {
					"id": "example-issue-next",
					"request": {
						"before": {
							"anchor": "0101010101010101010101010101010101010101010101010101010101010101",
							"epoch": 0,
							"exhausted": false,
							"lastIssued": -1
						},
						"candidate": {
							"anchor": "0101010101010101010101010101010101010101010101010101010101010101",
							"author": "example-author",
							"authorSequence": 0,
							"dependencies": [],
							"epoch": 0,
							"kind": "drp-vertex",
							"logicalTime": 0,
							"objectId": "object:example",
							"operation": {
								"action": "set",
								"key": "example",
								"value": true
							},
							"protocolMajor": 3
						},
						"privateKeyHex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
						"publicKeyHex": "030a107bff3ce10d12572b04818f051e27d17be51bbdd82099a9d85e9fb3"
					}
				},
				"semantics": "Apply the sustainable local-lineage issuance transition to before and candidate. privateKeyHex is present only for signing-capable cases. Instrument digest, sign and publication calls and return the post-state without mutating the request."
			},
			"digest-received": {
				"caseFields": ["id", "domain", "receivedHex", "reencodedHex"],
				"inputOnlyExample": {
					"id": "example-digest-received",
					"domain": "ts-drp/vertex/v3",
					"receivedHex": "<lowercase-even-length-received-preimage-hex>",
					"reencodedHex": "<lowercase-even-length-reencoded-preimage-hex>"
				},
				"semantics": "Hash the exact receivedHex bytes and the separately supplied reencodedHex bytes independently under domain; never substitute re-encoding for received bytes."
			},
			"verify-received": {
				"caseFields": ["id", "domain", "publicKeyHex", "receivedHex", "signatureHex"],
				"inputOnlyExample": {
					"id": "example-verify-received",
					"domain": "ts-drp/vertex/v3",
					"publicKeyHex": "<32-byte-lowercase-hex>",
					"receivedHex": "<lowercase-even-length-received-preimage-hex>",
					"signatureHex": "<64-byte-lowercase-hex-input>"
				},
				"semantics": "Compute the registered digest from exact receivedHex bytes under domain and verify signatureHex with strict Ed25519 verification against publicKeyHex."
			}
		},
		"decodeFailureAdapter": "A single-case nonzero process result is normalized only when stderr ends in a grammar-owned category; all other process failures are protocol failures.",
		"comparison": "deep equality after JSON parse; case order, ids, canonical bytes, parts, digest, normalized/decode value, error category, validation reason, issuance state, instrumentation, publication, signature and verification result are significant"
	},
