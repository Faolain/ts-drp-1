		"operationContracts": {
			"encode-corpus": {
				"caseFields": ["id", "kind", "input"],
				"inputOnlyExample": {
					"id": "example-encode-signer-set",
					"kind": "signerSet",
					"input": {
						"signers": [
							{
								"signerId": "example-author",
								"publicKey": "0101010101010101010101010101010101010101010101010101010101010101"
							}
						]
					}
				},
				"semantics": "Normalize input under the named registered kind, canonically encode the normalized value, construct that kind's ordered registered hash parts, and frame/hash them under the kind domain."
			},
			"decode-corpus": {
				"caseFields": ["id", "canonicalHex"],
				"optionalCaseFields": ["expectedErrorCategory"],
