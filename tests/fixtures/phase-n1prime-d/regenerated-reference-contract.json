	"neutralProtocol": {
		"transport": "one JSON request on stdin; one JSON response on stdout; stderr empty; exit status 0",
		"requestShape": {
			"operation": "one required operation name",
			"cases": "ordered array of cases"
		},
		"responseShape": {
			"results": "ordered array with exactly one result per case"
		},
		"operations": [
			"encode-corpus",
			"decode-corpus",
			"validate-cases",
			"issue-next",
			"digest-received",
			"verify-received"
