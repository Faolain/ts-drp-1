		["browser", "foreign-pair"],
		["browser", "torn-or-inconsistent"],
		["browser", "unreadable"],
		["node", "exact-pair"],
		["node", "absent-old"],
		["node", "foreign-pair"],
		["node", "torn-or-inconsistent"],
		["node", "unreadable"]
	]
