ated metadata.\n57\t */\n58\tmessage History {\n59\t  /**\n60\t   * The address book hash of the new history.\n61\t   */\n62\t  bytes address_book_hash = 1;\n63\t  /**\n64\t   * The metadata associated to the address book.\n65\t   */\n66\t  bytes metadata = 2;\n67\t}\n68\t\n69\t/**\n70\t * A proof that some address book history belongs to the ledger id's chain of trust.\n71\t */\n72\tmessage HistoryProof {\n73\t  /**\n74\t   * The proof keys for the target address book, needed to keep\n75\t   * constructing proofs after adopting the target address book's\n76\t   * roster at a handoff.\n77\t   */\n78\t  repeated ProofKey target_proof_keys = 1;\n79\t  /**\n80\t   * The target history of the proof.\n81\t   */\n82\t  History target_history = 2;\n83\t  /**\n84\t   * The proof of chain of trust from the ledger id to the target\n85\t   * history's metadata. May be switched from AggregatedNodeSignatures\n86\t   * to a recursive proof when one becomes available.\n87\t   */\n88\t  ChainOfTrustProof chain_of_trust_proof = 3;\n89\t  /**\n90\t   * If set, the uncompressed proof of chain of trust from the ledger id to\n91\t   * the target address book; the uncompressed version of the WRAPS proof is\n92\t   * required to keep extending the chain of trust.\n93\t   */\n94\t  bytes uncompressed_wraps_proof = 4;\n95\t}\n96\t\n97\t/**\n98\t * Summary of the status of constructing a metadata proof, necessary to\n99\t * ensure deterministic construction ending in a roster with sufficient\n100\t * weight to enact its own constructions.\n101\t */\n102\tmessage HistoryProofConstruction {\n103\t  reserved 3;\n104\t\n105\t  /**\n106\t   * The construction id.\n107\t   */\n108\t  uint64 construction_id = 1;\n109\t  /**\n110\t   * The hash of the roster whose weights are used to determine when\n111\t   * certain thresholds are during construction.\n112\t   */\n113\t  bytes source_roster_hash = 2;\n114\t  /**\n115\t   * The hash of the roster whose weights are used to assess progress\n116\t   * toward obtaining proof keys for parties that hold at least a\n117\t   * strong minority of the stake in that roster.\n118\t   */\n119\t  bytes target_roster_hash = 4;\n120\t\n121\t  oneof proof_state {\n122\t    /**\n123\t     * If the network is still gathering proof keys for this\n124\t     * construction, the next time at which nodes should stop waiting\n125\t     * for tardy proof keys and assemble the history to be proven as\n126\t     * soon as it has the associated metadata and proof keys for nodes\n127\t     * with >2/3 weight in the target roster.\n128\t     */\n129\t    proto.Timestamp grace_period_end_time = 5;\n130\t    /**\n131\t     * If the network has gathered enough proof keys to assemble the\n132\t     * history for this construction, the cutoff time at which those\n133\t     * keys must have been adopted to be included in the final history.\n134\t     */\n135\t    proto.Timestamp assembly_start_time = 6;\n136\t    /**\n137\t     * When this construction is complete, the proof that the target\n138\t     * roster's address book and associated metadata belong to the\n139\t     * ledger id's chain of trust.\n140\t     */\n141\t    HistoryProof target_proof = 7;\n142\t    /**\n143\t     * If set, the reason the construction failed.\n144\t     */\n145\t    string failure_reason = 8;\n146\t    /**\n147\t     * If set, the state of the WRAPS signing protocol for this construction.\n148\t     */\n149\t    WrapsSigningState wraps_signing_state = 9;\n150\t  }\n151\t\n152\t  /**\n153\t   * The number of times the network has had to restart this construction.\n154\t   */\n155\t  uint32 wraps_retry_count = 10;\n156\t}\n157\t\n158\t/**\n159\t * The state of an ongoing WRAPS signature protocol.\n160\t */\n161\tmessage WrapsSigningState {\n162\t  /**\n163\t   * The phase of the WRAPS protocol.\n164\t   */\n165\t  WrapsPhase phase = 1;\n166\t\n167\t  /**\n168\t   * If the network is still gathering WRAPS messages for the R2 or R3\n169\t   * protocol phase, the next