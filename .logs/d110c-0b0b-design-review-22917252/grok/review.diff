+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SKYrg5m7ZqtCvQGPny67Cc","type":"tool_result","content":"1\t// SPDX-License-Identifier: Apache-2.0\n2\tpackage com.hedera.node.app.history;\n3\t\n4\timport static java.util.Objects.requireNonNull;\n5\timport static org.hiero.base.utility.CommonUtils.hex;\n6\t\n7\timport com.hedera.cryptography.wraps.Proof;\n8\timport com.hedera.cryptography.wraps.SchnorrKeys;\n9\timport com.hedera.cryptography.wraps.WRAPSLibraryBridge;\n10\timport com.hedera.pbj.runtime.io.buffer.Bytes;\n11\timport edu.umd.cs.findbugs.annotations.NonNull;\n12\timport java.util.Arrays;\n13\timport java.util.Set;\n14\timport java.util.SortedMap;\n15\timport java.util.function.LongFunction;\n16\timport java.util.function.LongUnaryOperator;\n17\timport java.util.stream.Collectors;\n18\timport java.util.stream.IntStream;\n19\t\n20\t/**\n21\t * The cryptographic operations required by the {@link HistoryService}.\n22\t */\n23\tpublic interface HistoryLibrary {\n24\t    /**\n25\t     * The sentinel public key to use when a node fails to publish its proof key within the grace period.\n26\t     * The corresponding private key is intentionally unavailable, so this key must never be used for signing.\n27\t     */\n28\t    Bytes MISSING_SCHNORR_KEY = Bytes.wrap(WRAPSLibraryBridge.getInstance().provideSentinelPublicKey());\n29\t\n30\t    /**\n31\t     * An address book for use in the history library.\n32\t     * @param weights the weights of the nodes in the address book\n33\t     * @param publicKeys the public keys of the nodes in the address book\n34\t     * @param nodeIds the node ids\n35\t     */\n36\t    record AddressBook(\n37\t            @NonNull long[] weights,\n38\t            @NonNull byte[][] publicKeys,\n39\t            @NonNull long[] nodeIds) {\n40\t        public AddressBook {\n41\t            requireNonNull(weights);\n42\t            requireNonNull(publicKeys);\n43\t            requireNonNull(nodeIds);\n44\t        }\n45\t\n46\t        /**\n47\t         * Creates an address book from the given weights and public keys (indexed by node id).\n48\t         * @param weights the weights of the nodes in the address book\n49\t         * @param publicKeys the public keys of the nodes in the address book\n50\t         * @return the address book\n51\t         */\n52\t        public static AddressBook from(\n53\t                @NonNull final SortedMap<Long, Long> weights, @NonNull final SortedMap<Long, byte[]> publicKeys) {\n54\t            requireNonNull(weights);\n55\t            requireNonNull(publicKeys);\n56\t            final var missingKey = MISSING_SCHNORR_KEY.toByteArray();\n57\t            return from(weights, nodeId -> publicKeys.getOrDefault(nodeId, missingKey));\n58\t        }\n59\t\n60\t        /**\n61\t         * Creates an address book from the given weights and public keys (indexed by node id).\n62\t         * @param weights the weights of the nodes in the address book\n63\t         * @param publicKeys the public keys of the nodes in the address book\n64\t         * @return the address book\n65\t         */\n66\t        public static AddressBook from(\n67\t                @NonNull final SortedMap<Long, Long> weights, @NonNull final LongFunction<byte[]> publicKeys) {\n68\t            requireNonNull(weights);\n69\t            requireNonNull(publicKeys);\n70\t            final var nodeIds =\n71\t                    weights.keySet().stream().mapToLong(Long::longValue).toArray();\n72\t            return new AddressBook(\n73\t                    Arrays.stream(nodeIds).map(weights::get).toArray(),\n74\t                    Arrays.stream(nodeIds).mapToObj(publicKeys).toArray(byte[][]::new),\n75\t                    nodeIds);\n76\t        }\n77\t\n78\t        /**\n79\t         * Returns a mask for the given signers.\n80\t         * @param signers the signers\n81\t         * @return the mask\n82\t         */\n83\t        public boolean[] signersMask(@NonNull final Set<Long> signers) {\n84\t            final var mask = new boolean[nodeIds.length];\n85\t            for (int i = 0; i < nodeIds.length; i++) {\n86\t                mask[i] = signers.contains(nodeIds[i]);\n87\t            }\n88\t            return mask;\n89\t        }\n90\t\n91\t        @NonNull\n92\t        @Override\n93\t        public String toString() {\n94\t            return \"AddressBook\"\n95\t                    + IntStream.range(0, nodeIds.length)\n96\t                            .mapToObj(i -> \"(#\" + i + \" :: weight=\"\n97\t                                    + weights[i] + \" :: public_key=\"\n98\t                                    + hex(publicKeys[i]) + \")\")\n99\t                            .collect(Collectors.joining(\", \", \"[\", \"]\"));\n100\t        }\n101\t    }\n102\t\n103\t    /**\n104\t     * Computes the canonical hash of the given situation from a {@link HistoryLibrary}.\n105\t     * @param library the library\n106\t     * @param nodeIds the node ids\n107\t     * @param weightFn the weight function\n108\t     * @param proofKeyFn the proof key function\n109\t     * @return the canonical hash\n110\t     */\n111\t    static Bytes computeHash(\n112\t            @NonNull final HistoryLibrary library,\n113\t            @NonNull final Set<Long> nodeIds,\n114\t            @NonNull final LongUnaryOperator weightFn,\n115\t            @NonNull final LongFunction<Bytes> proofKeyFn) {\n116\t        requireNonNull(nodeIds);\n117\t        requireNonNull(weightFn);\n118\t        requireNonNull(proofKeyFn);\n119\t        final var sortedNodeIds =\n120\t                nodeIds.stream().sorted().mapToLong(Long::longValue).toArray();\n121\t        final var targetWeights = Arrays.stream(sortedNodeIds).map(weightFn).toArray();\n122\t        final var proofKeysArray = Arrays.stream(sortedNodeIds)\n123\t                .mapToObj(proofKeyFn)\n124\t                .map(Bytes::toByteArray)\n125\t                .toArray(byte[][]::new);\n126\t        return Bytes.wrap(library.hashAddre