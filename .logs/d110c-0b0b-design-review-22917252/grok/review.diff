+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CvLz86veifTqU5TBZpVC3M","type":"tool_result","content":"1\t// SPDX-License-Identifier: Apache-2.0\n2\tpackage org.hiero.consensus.reconnect.impl;\n3\t\n4\timport static com.swirlds.logging.legacy.LogMarker.EXCEPTION;\n5\timport static org.hiero.consensus.platformstate.PlatformStateUtils.consensusTimestampOf;\n6\timport static org.hiero.consensus.platformstate.PlatformStateUtils.getInfoString;\n7\timport static org.hiero.consensus.platformstate.PlatformStateUtils.roundOf;\n8\t\n9\timport com.hedera.hapi.node.state.roster.Roster;\n10\timport com.swirlds.state.State;\n11\timport org.apache.logging.log4j.LogManager;\n12\timport org.apache.logging.log4j.Logger;\n13\timport org.hiero.consensus.state.signed.SignedState;\n14\timport org.hiero.consensus.state.signed.SignedStateInvalidException;\n15\t\n16\t/**\n17\t * Validates a signed state by summing the amount of weight held by the valid signatures on the state.\n18\t */\n19\tpublic class DefaultSignedStateValidator implements SignedStateValidator {\n20\t    private static final Logger logger = LogManager.getLogger(DefaultSignedStateValidator.class);\n21\t\n22\t    /**\n23\t     * {@inheritDoc}\n24\t     */\n25\t    public void validate(\n26\t            final SignedState signedState, final Roster roster, SignedStateValidationData previousStateData) {\n27\t        throwIfOld(signedState, previousStateData);\n28\t        signedState.pruneInvalidSignatures(roster);\n29\t        signedState.throwIfNotVerifiable();\n30\t    }\n31\t\n32\t    /**\n33\t     * Check the signed state against metadata from a prior state, and throw if the new state is older. After a\n34\t     * reconnect, there is a slight possibility the teacher sent older state than we already had.  In that case we do\n35\t     * not want to keep the state, but try again with a different teacher.  This method checks that the received state\n36\t     * is at least as new as the state we started with, and throws if the received state is not acceptable.\n37\t     *\n38\t     * @param signedState       a newly received signed state from a reconnect process.\n39\t     * @param previousStateData The validation data from the current address book and prior state, before reconnect.\n40\t     * @throws SignedStateInvalidException if the signed state is not at least as new as the previous state.\n41\t     */\n42\t    private void throwIfOld(final SignedState signedState, final SignedStateValidationData previousStateData)\n43\t            throws SignedStateInvalidException {\n44\t\n45\t        State state = signedState.getState();\n46\t        if (roundOf(state) < previousStateData.round()\n47\t                || consensusTimestampOf(state).isBefore(previousStateData.consensusTimestamp())) {\n48\t            logger.error(EXCEPTION.getMarker(), \"\"\"\n49\t                            State is too old. Failed reconnect state:\n50\t                            {}\n51\t                            Original reconnect state:\n52\t                            {}\"\"\", getInfoString(state), previousStateData.getInfoString());\n53\t            throw new SignedStateInvalidException((\"Received signed state is for a round smaller than or a \"\n54\t                            + \"consensus earlier than what we started with. Original round %d, received round %d. \"\n55\t                            + \"Original timestamp %s, received timestamp %s.\")\n56\t                    .formatted(\n57\t                            previousStateData.round(),\n58\t                            signedState.getRound(),\n59\t                            previousStateData.consensusTimestamp(),\n60\t                            signedState.getConsensusTimestamp()));\n61\t        }\n62\t    }\n63\t}\n64\t"}]},"parent_tool_use_id":null,"session_id":"0b68b30f-133f-4078-a9a7-ee7aeeec8953","uuid":"bcc9a981-74cd-47e9-aa59-65a65a8d4142","timestamp":"2026-09-02T08:27:00.695Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/hcn/DefaultSignedStateValidator.java","content":"// SPDX-License-Identifier: Apache-2.0\npackage org.hiero.consensus.reconnect.impl;\n\nimport static com.swirlds.logging.legacy.LogMarker.EXCEPTION;\nimport static org.hiero.consensus.platformstate.PlatformStateUtils.consensusTimestampOf;\nimport static org.hiero.consensus.platformstate.PlatformStateUtils.getInfoString;\nimport static org.hiero.consensus.platformstate.PlatformStateUtils.roundOf;\n\nimport com.hedera.hapi.node.state.roster.Roster;\nimport com.swirlds.state.State;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\nimport org.hiero.consensus.state.signed.SignedState;\nimport org.hiero.consensus.state.signed.SignedStateInvalidException;\n\n/**\n * Validates a signed state by summing the amount of weight held by the valid signatures on the state.\n */\npublic class DefaultSignedStateValidator implements SignedStateValidator {\n    private static final Logger logger = LogManager.getLogger(DefaultSignedStateValidator.class);\n\n    /**\n     * {@inheritDoc}\n     */\n    public void validate(\n            final SignedState signedState, final Roster roster, SignedStateValidationData previousStateData) {\n        throwIfOld(signedState, previousStateData);\n        signedState.pruneInvalidSignatures(roster);\n        signedState.throwIfNotVerifiable();\n    }\n\n    /**\n     * Check the signed state against metadata from a prior state, and throw if the new state is older. After a\n     * reconnect, there is a slight possibility the teacher sent older state than we already had.  In that case we do\n     * not want to keep the state, but try again with a different teacher.  This method checks that the received state\n     * is at least as new as the state we started with, and throws if the received state is not acceptable.\n     *\n     * @param signedState       a newly received signed state from a reconnect process.\n     * @param previousStateData The validation data from the current address book and prior state, before reconnect.\n     * @throws SignedStateInvalidException if the signed state is not at least as new as the previous state.\n     */\n    private void throwIfOld(final SignedState signedState, final SignedStateValidationData previousStateData)\n            throws SignedStateInvalidException {\n\n        State state = signedState.getState();\n        if (roundOf(state) < previousStateData.round()\n                || consensusTimestampOf(state).isBefore(previousStateData.consensusTimestamp())) {\n            logger.error(EXCEPTION.getMarker(), \"\"\"\n                            State is too old. Failed reconnect state:\n                            {}\n                            Original reconnect state:\n                            {}\"\"\", getInfoString(state), previousStateData.getInfoString());\n            throw new SignedStateInvalidException((\"Received signed state is for a round smaller than or a \"\n                            + \"consensus earlier than what we started with. Original round %d, received round %d. \"\n                            + \"Original timestamp %s, received timestamp %s.\")\n                    .formatted(\n                            previousStateData.round(),\n                            signedState.getRound(),\n                            previousStateData.consensusTimestamp(),\n                            signedState.getConsensusTimestamp()));\n        }\n    }\n}\n","numLines":64,"startLine":1,"totalLines":64}}}
