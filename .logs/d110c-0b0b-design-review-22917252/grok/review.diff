 and R1 messages.\n244\t   */\n245\t  R1 = 0;\n246\t  /**\n247\t   * Nodes are publishing their R2 messages.\n248\t   */\n249\t  R2 = 1;\n250\t  /**\n251\t   * Nodes are publishing their R3 messages.\n252\t   */\n253\t  R3 = 2;\n254\t  /**\n255\t   * Nodes are aggregating all messages to produce a final signature.\n256\t   */\n257\t  AGGREGATE = 3;\n258\t  /**\n259\t   * Nodes are doing work that must occur in a different event loop\n260\t   * than the one used for the above phases.\n261\t   */\n262\t  POST_AGGREGATION = 4;\n263\t}\n264\t\n265\t/**\n266\t * A message published by a node during a WRAPS proof construction.\n267\t */\n268\tmessage WrapsMessageDetails {\n269\t  /**\n270\t   * The time at which the message was published.\n271\t   */\n272\t  proto.Timestamp publication_time = 1;\n273\t  /**\n274\t   * The phase of the construction the message applies to.\n275\t   */\n276\t  WrapsPhase phase = 2;\n277\t  /**\n278\t   * The message itself.\n279\t   */\n280\t  bytes message = 3;\n281\t}\n282\t\n283\t/**\n284\t * A history of messages published during a WRAPS proof construction.\n285\t */\n286\tmessage WrapsMessageHistory {\n287\t  /*\n288\t   * The published messages.\n289\t   */\n290\t  repeated WrapsMessageDetails messages = 1;\n291\t}\n292\t\n293\tmessage ChainOfTrustProof {\n294\t    oneof proof {\n295\t        /**\n296\t         * If there is not yet a SNARK proving the chain of trust from ledger id to\n297\t         * the hinTS verification key, an aggregation of Schnorr signatures on\n298\t         * the concatenation of the ledger id and genesis hinTS verification key\n299\t         * that serve as witnesses for the SNARK prover algorithm.\n300\t         */\n301\t        AggregatedNodeSignatures aggregated_node_signatures = 1;\n302\t        /**\n303\t         * If known, a ZK-compressed SNARK proof proving the chain of trust from\n304\t         * the ledger id to this hinTS verification key.\n305\t         */\n306\t        bytes wraps_proof = 2;\n307\t    }\n308\t}\n309\t\n310\t/**\n311\t * An aggregation of node signatures on some data.\n312\t * <p>\n313\t * Can be used to prove the genesis hinTS verification key in a block proof; but\n314\t * not succinct and not recursive; hence in normal operations with TSS, used only\n315\t * until the first recursive proof is available.\n316\t */\n317\tmessage AggregatedNodeSignatures {\n318\t  /**\n319\t   * The aggregated signature.\n320\t   */\n321\t  bytes aggregated_signature = 1;\n322\t  /**\n323\t   * In ascending order, the ids of the nodes that contributed signatures.\n324\t   */\n325\t  repeated uint64 signing_node_ids = 2;\n326\t  /**\n327\t   * The hinTS key that this signature witnesses.\n328\t   */\n329\t  bytes verification_key = 3;\n330\t}\n331\t"}]},"parent_tool_use_id":null,"session_id":"0b68b30f-133f-4078-a9a7-ee7aeeec8953","uuid":"1fa9fb96-65d4-4cfa-a034-c147e65f61f3","timestamp":"2026-09-02T08:26:38.198Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/hcn/history_types.proto","content":"syntax = \"proto3\";\n\npackage com.hedera.hapi.node.state.history;\n\n// SPDX-License-Identifier: Apache-2.0\nimport \"services/timestamp.proto\";\n\noption java_package = \"com.hederahashgraph.api.proto.java\";\n// <<<pbj.java_package = \"com.hedera.hapi.node.state.history\">>> This comment is special code for setting PBJ Compiler java package\noption java_multiple_files = true;\n\n/**\n * A set of proof keys for a node; that is, the key the node is\n * currently using and the key it wants to use in assembling the\n * next address book in the ledger id's chain of trust.\n */\nmessage ProofKeySet {\n  /**\n   * The consensus time when the network adopted the active\n   * proof key in this set. An adoption time that is sufficiently\n   * tardy relative to the latest assembly start time may result\n   * in the node's key being omitted from the address book.\n   */\n  proto.Timestamp adoption_time = 2;\n  /**\n   * The proof key the node is using.\n   */\n  bytes key = 3;\n  /**\n   * If set, the proof key the node wants to start using in the\n   * address book.\n   */\n  bytes next_key = 4;\n}\n\n/**\n * A record of the proof key a node had in a particular address\n * book. Necessary to keep at each point history so that nodes\n * can verify the correct key was used to sign in transitions\n * starting from the current address book; no matter how keys\n * have been rotated from the time the address book was created.\n */\nmessage ProofKey {\n  /**\n   * The node id.\n   */\n  uint64 node_id = 1;\n  /**\n   * The key.\n   */\n  bytes key = 2;\n}\n\n/**\n * A piece of new history in the form of an address book hash and\n * associated metadata.\n */\nmessage History {\n  /**\n   * The address book hash of the new history.\n   */\n  bytes address_book_hash = 1;\n  /**\n   * The metadata associated to the address book.\n   */\n  bytes metadata = 2;\n}\n\n/**\n * A proof that some address book history belongs to the ledger id's chain of trust.\n */\nmessage HistoryProof {\n  /**\n   * The proof keys for the target address book, needed to keep\n   * constructing proofs after adopting the target address book's\n   * roster at a handoff.\n   */\n  repeated ProofKey target_proof_keys = 1;\n  /**\n   * The target history of the proof.\n   */\n  History target_history = 2;\n  /**\n   * The proof of chain of trust from the ledger id to the target\n   * history's metadata. May be switched from AggregatedNodeSignatures\n   * to a recursive proof when one becomes available.\n   */\n  ChainOfTrustProof chain_of_trust_proof = 3;\n  /**\n   * If set, the uncompressed proof of chain of trust from the ledger id to\n   * the target address book; the uncompressed version of the WRAPS proof is\n   * required to keep extending the chain of trust.\n   */\n  bytes uncompressed_wraps_proof = 4;\n}\n\n/**\n * Summary of the status of constructing a metadata proof, necessary to\n * ensure deterministic construction ending in a roster with sufficient\n * weight to enact its own constructions.\n */\nmessage HistoryProofConstruction {\n  reserved 3;\n\n  /**\n   * The construction id.\n   */\n  uint64 construction_id = 1;\n  /**\n   * The hash of the roster whose weights are used to determine when\n   * certain thresholds are during construction.\n   */\n  bytes source_roster_hash = 2;\n  /**\n   * The hash of the roster whose weights are used to assess progress\n   * toward obtaining proof keys for parties that hold at least a\n   * strong minority of the stake in that roster.\n   */\n  bytes target_roster_hash = 4;\n\n  oneof proof_state {\n    /**\n     * If the network is still gathering proof keys for this\n     * construction, the next time at which nodes should stop waiting\n     * for tardy proof keys and assemble the history to be proven as\n     * soon as it has the associated metadata and proof keys for nodes\n     * with >2/3 weight in the target roster.\n     */\n    proto.Timestamp grace_period_end_time = 5;\n    /**\n     * If the network has gathered enough proof keys to assemble the\n     * history for this construction, the cutoff time at which those\n     * keys must have been adopted to be included in the final history.\n     */\n    proto.Timestamp assembly_start_time = 6;\n    /**\n     * When this construction is complete, the proof that the target\n     * roster's address book and associated metadata belong to the\n     * ledger id's chain of trust.\n     */\n    HistoryProof target_proof = 7;\n    /**\n     * If set, the reason the construction failed.\n     */\n    string failure_reason = 8;\n    /**\n     * If set, the state of the WRAPS signing protocol for this construction.\n     */\n    WrapsSigningState wraps_signing_state = 9;\n  }\n\n  /**\n   * The number of times the network has had to restart this construction.\n   */\n  uint32 wraps_retry_count = 10;\n}\n\n/**\n * The state of an ongoing WRAPS signature protocol.\n */\nmessage WrapsSigningState {\n  /**\n   * The phase of the WRAPS protocol.\n   */\n  WrapsPhase phase = 1;\n\n  /**\n   * If the network is still gathering WRAPS messages for the R2 or R3\n   * protocol phase, the next time at which nodes should stop waiting\n   * for tardy messages from R1 participants and start over.\n   */\n  proto.Timestamp grace_period_end_time = 2;\n}\n\n/**\n * A construction-scoped node id.\n */\nmessage ConstructionNodeId {\n  /**\n   * The unique id of a history proof construction.\n   */\n  uint64 construction_id = 1;\n  /**\n   * The unique id of a node.\n   */\n  uint64 node_id = 2;\n}\n\n/**\n * A node's vote for a particular history proof; either by explicitly\n * giving the proof, or by identifying a node that already voted for it.\n */\nmessage HistoryProofVote {\n  oneof vote {\n    /**\n     * The history proof the submitting node is voting for.\n     */\n    HistoryProof proof = 1;\n    /**\n     * The id of another node that already voted for the exact proof\n     * the submitting node is voting for.\n     */\n    uint64 congruent_node_id = 2;\n  }\n}\n\n/**\n * A node's signature blessing some new history.\n */\nmessage HistorySignature {\n  /**\n   * The new history the node is signing.\n   */\n  History history = 1;\n  /**\n   * The node's signature on the canonical serialization of\n   * the new history.\n   */\n  bytes signature = 2;\n}\n\n/**\n * A signature on some new history recorded at a certain time.\n */\nmessage RecordedHistorySignature {\n  /**\n   * The time at which the signature was recorded.\n   */\n  proto.Timestamp signing_time = 1;\n\n  /**\n   * The signature on some new history.\n   */\n  HistorySignature history_signature = 2;\n}\n\n\n/**\n * The phase of a WRAPS proof construction.\n */\nenum WrapsPhase {\n  /**\n   * Nodes are publishing their proof keys and R1 messages.\n   */\n  R1 = 0;\n  /**\n   * Nodes are publishing their R2 messages.\n   */\n  R2 = 1;\n  /**\n   * Nodes are publishing their R3 messages.\n   */\n  R3 = 2;\n  /**\n   * Nodes are aggregating all messages to produce a final signature.\n   */\n  AGGREGATE = 3;\n  /**\n   * Nodes are doing work that must occur in a different event loop\n   * than the one used for the above phases.\n   */\n  POST_AGGREGATION = 4;\n}\n\n/**\n * A message published by a node during a WRAPS proof construction.\n */\nmessage WrapsMessageDetails {\n  /**\n   * The time at which the message was published.\n   */\n  proto.Timestamp publication_time = 1;\n  /**\n   * The phase of the construction the message applies to.\n   */\n  WrapsPhase phase = 2;\n  /**\n   * The message itself.\n   */\n  bytes message = 3;\n}\n\n/**\n * A history of messages published during a WRAPS proof construction.\n */\nmessage WrapsMessageHistory {\n  /*\n   * The published messages.\n   */\n  repeated WrapsMessageDetails messages = 1;\n}\n\nmessage ChainOfTrustProof {\n    oneof proof {\n        /**\n         * If there is not yet a SNARK proving the chain of trust from ledger id to\n         * the hinTS verification key, an aggregation of Schnorr signatures on\n         * the concatenation of the ledger id and genesis hinTS verification key\n         * that serve as witnesses for the SNARK prover algorithm.\n         */\n        AggregatedNodeSignatures aggregated_node_signatures = 1;\n        /**\n         * If known, a ZK-compressed SNARK proof proving the chain of trust from\n         * the ledger id to this hinTS verification key.\n         */\n        bytes wraps_proof = 2;\n    }\n}\n\n/**\n * An aggregation of node signatures on some data.\n * <p>\n * Can be used to prove the genesis hinTS verification key in a block proof; but\n * not succinct and not recursive; hence in normal operations with TSS, used only\n * until the first recursive proof is available.\n */\nmessage AggregatedNodeSignatures {\n  /**\n   * The aggregated signature.\n   */\n  bytes aggregated_signature = 1;\n  /**\n   * In ascending order, the ids of the nodes that contributed signatures.\n   */\n  repeated uint64 signing_node_ids = 2;\n  /**\n   * The hinTS key that this signature witnesses.\n   */\n  bytes verification_key = 3;\n}\n","numLines":331,"startLine":1,"totalLines":331}}}
+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7UVp15KiQjdKCFmMkngX3","type":"tool_result","content":"1\t// SPDX-License-Identifier: Apache-2.0\n2\tpackage com.hedera.node.app.history.impl;\n3\t\n4\timport static com.hedera.hapi.node.state.history.WrapsPhase.AGGREGATE;\n5\timport static com.hedera.hapi.node.state.history.WrapsPhase.POST_AGGREGATION;\n6\timport static com.hedera.hapi.node.state.history.WrapsPhase.R1;\n7\timport static com.hedera.hapi.node.state.history.WrapsPhase.R2;\n8\timport static com.hedera.hapi.node.state.history.WrapsPhase.R3;\n9\timport static com.hedera.node.app.service.roster.impl.RosterTransitionWeights.moreThanHalfOfTotal;\n10\timport static java.util.Objects.requireNonNull;\n11\t\n12\timport com.hedera.hapi.node.state.history.WrapsPhase;\n13\timport com.hedera.node.app.history.ReadableHistoryStore.WrapsMessagePublication;\n14\timport com.hedera.node.app.service.roster.impl.RosterTransitionWeights;\n15\timport edu.umd.cs.findbugs.annotations.NonNull;\n16\timport edu.umd.cs.findbugs.annotations.Nullable;\n17\timport java.time.Duration;\n18\timport java.time.Instant;\n19\timport java.util.Map;\n20\timport java.util.Set;\n21\timport java.util.SortedMap;\n22\timport java.util.TreeMap;\n23\timport javax.inject.Inject;\n24\timport javax.inject.Singleton;\n25\t\n26\t/**\n27\t * State machine logic for the multi-party computation (MPC) phases of the WRAPS protocol.\n28\t */\n29\t@Singleton\n30\tpublic class WrapsMpcStateMachine {\n31\t    public static final Set<WrapsPhase> POST_MPC_PHASES = Set.of(AGGREGATE, POST_AGGREGATION);\n32\t\n33\t    @Inject\n34\t    public WrapsMpcStateMachine() {\n35\t        // Dagger2\n36\t    }\n37\t\n38\t    /**\n39\t     * Represents a transition of the WRAPS signing state machine; may be a no-op transition, and always is\n40\t     * if the publication triggering the transition was not accepted (e.g., because it was for the wrong phase\n41\t     * or was a duplicate).\n42\t     * @param publicationAccepted whether the publication triggering the transition was accepted\n43\t     * @param newCurrentPhase the new current phase after the transition\n44\t     * @param gracePeriodEndTimeUpdate the new grace period end time after the transition, if applicable\n45\t     */\n46\t    public record Transition(\n47\t            boolean publicationAccepted,\n48\t            @NonNull WrapsPhase newCurrentPhase,\n49\t            @Nullable Instant gracePeriodEndTimeUpdate) {\n50\t        public Transition {\n51\t            requireNonNull(newCurrentPhase);\n52\t        }\n53\t\n54\t        public static Transition rejectedAt(@NonNull final WrapsPhase currentPhase) {\n55\t            return new Transition(false, currentPhase, null);\n56\t        }\n57\t\n58\t        public static Transition incorporatedIn(@NonNull final WrapsPhase currentPhase) {\n59\t            return new Transition(true, currentPhase, null);\n60\t        }\n61\t\n62\t        public static Transition advanceTo(\n63\t                @NonNull final WrapsPhase currentPhase, @Nullable final Instant gracePeriodEndTimeUpdate) {\n64\t            return new Transition(true, currentPhase, gracePeriodEndTimeUpdate);\n65\t        }\n66\t    }\n67\t\n68\t    /**\n69\t     * Computes the next state of the WRAPS signing state machine given the current state and a new publication.\n70\t     * <p>\n71\t     * <b>Important:</b> On acceptance, has the side effect of adding the publication to the phase messages map.\n72\t     * @param publication the new publication\n73\t     * @param currentPhase the current phase\n74\t     * @param weights the weights for parties in the MPC\n75\t     * @param gracePeriod the grace period for each phase of the protocol\n76\t     * @param phaseMessages the map of phase messages published so far\n77\t     * @return the transition\n78\t     */\n79\t    public Transition onNext(\n80\t            @NonNull final WrapsMessagePublication publication,\n81\t            @NonNull final WrapsPhase currentPhase,\n82\t            @NonNull final RosterTransitionWeights weights,\n83\t            @NonNull final Duration gracePeriod,\n84\t            @NonNull final Map<WrapsPhase, SortedMap<Long, WrapsMessagePublication>> phaseMessages) {\n85\t        requireNonNull(publication);\n86\t        requireNonNull(currentPhase);\n87\t        requireNonNull(weights);\n88\t        requireNonNull(gracePeriod);\n89\t        requireNonNull(phaseMessages);\n90\t        // The final phase involves publishing votes, not messages, so abort\n91\t        if (currentPhase == AGGREGATE) {\n92\t            return Transition.rejectedAt(AGGREGATE);\n93\t        }\n94\t        // Otherwise the phase should match the current phase\n95\t        if (publication.phase() != currentPhase) {\n96\t            return Transition.rejectedAt(currentPhase);\n97\t        }\n98\t        final var messages = phaseMessages.computeIfAbsent(currentPhase, p -> new TreeMap<>());\n99\t        if (currentPhase == R1) {\n100\t            if (messages.putIfAbsent(publication.nodeId(), publication) != null) {\n101\t                return Transition.rejectedAt(currentPhase);\n102\t            }\n103\t            final long r1Weight = messages.values().stream()\n104\t                    .mapToLong(p -> weights.sourceWeightOf(p.nodeId()))\n105\t                    .sum();\n106\t            if (r1Weight >= moreThanHalfOfTotal(weights.sourceNodeWeights())) {\n107\t                return Transition.advanceTo(R2, publication.receiptTime().plus(gracePeriod));\n108\t            }\n109\t        } else {\n110\t            final var r1Nodes = phaseMessages.get(R1).keySet();\n111\t            if (!r1Nodes.contains(publication.nodeId())) {\n112\t                return Transition.rejectedAt(currentPhase);\n113\t            }\n114\t            if (messages.putIfAbsent(publication.nodeId(), publication) != null) {\n115\t                return Transition.rejectedAt(currentPhase);\n116\t            }\n117\t            if (messages.keySet().containsAll(r1Nodes)) {\n118\t                final var nextPhase = currentPhase == R2 ? R3 : AGGREGATE;\n119\t                final var nextGracePeriodEndTime =\n120\t                        currentPhase == R2 ? publication.receiptTime().plus(gracePeriod) : null;\n121\t                return Transition.advanceTo(nextPhase, nextGracePeriodEndTime);\n122\t            }\n123\t        }\n124\t        return Transition.incorporatedIn(currentPhase);\n125\t    }\n126\t}\n127\t"}]},"parent_tool_use_id":null,"session_id":"0b68b30f-133f-4078-a9a7-ee7aeeec8953","uuid":"3ec824b2-176e-4afb-98db-9fc363458933","timestamp":"2026-09-02T08:26:38.199Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/hcn/WrapsMpcStateMachine.java","content":"// SPDX-License-Identifier: Apache-2.0\npackage com.hedera.node.app.history.impl;\n\nimport static com.hedera.hapi.node.state.history.WrapsPhase.AGGREGATE;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.POST_AGGREGATION;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.R1;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.R2;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.R3;\nimport static com.hedera.node.app.service.roster.impl.RosterTransitionWeights.moreThanHalfOfTotal;\nimport static java.util.Objects.requireNonNull;\n\nimport com.hedera.hapi.node.state.history.WrapsPhase;\nimport com.hedera.node.app.history.ReadableHistoryStore.WrapsMessagePublication;\nimport com.hedera.node.app.service.roster.impl.RosterTransitionWeights;\nimport edu.umd.cs.findbugs.annotations.NonNull;\nimport edu.umd.cs.findbugs.annotations.Nullable;\nimport java.time.Duration;\nimport java.time.Instant;\nimport java.util.Map;\nimport java.util.Set;\nimport java.util.SortedMap;\nimport java.util.TreeMap;\nimport javax.inject.Inject;\nimport javax.inject.Singleton;\n\n/**\n * State machine logic for the multi-party computation (MPC) phases of the WRAPS protocol.\n */\n@Singleton\npublic class WrapsMpcStateMachine {\n    public static final Set<WrapsPhase> POST_MPC_PHASES = Set.of(AGGREGATE, POST_AGGREGATION);\n\n    @Inject\n    public WrapsMpcStateMachine() {\n        // Dagger2\n    }\n\n    /**\n     * Represents a transition of the WRAPS signing state machine; may be a no-op transition, and always is\n     * if the publication triggering the transition was not accepted (e.g., because it was for the wrong phase\n     * or was a duplicate).\n     * @param publicationAccepted whether the publication triggering the transition was accepted\n     * @param newCurrentPhase the new current phase after the transition\n     * @param gracePeriodEndTimeUpdate the new grace period end time after the transition, if applicable\n     */\n    public record Transition(\n            boolean publicationAccepted,\n            @NonNull WrapsPhase newCurrentPhase,\n            @Nullable Instant gracePeriodEndTimeUpdate) {\n        public Transition {\n            requireNonNull(newCurrentPhase);\n        }\n\n        public static Transition rejectedAt(@NonNull final WrapsPhase currentPhase) {\n            return new Transition(false, currentPhase, null);\n        }\n\n        public static Transition incorporatedIn(@NonNull final WrapsPhase currentPhase) {\n            return new Transition(true, currentPhase, null);\n        }\n\n        public static Transition advanceTo(\n                @NonNull final WrapsPhase currentPhase, @Nullable final Instant gracePeriodEndTimeUpdate) {\n            return new Transition(true, currentPhase, gracePeriodEndTimeUpdate);\n        }\n    }\n\n    /**\n     * Computes the next state of the WRAPS signing state machine given the current state and a new publication.\n     * <p>\n     * <b>Important:</b> On acceptance, has the side effect of adding the publication to the phase messages map.\n     * @param publication the new publication\n     * @param currentPhase the current phase\n     * @param weights the weights for parties in the MPC\n     * @param gracePeriod the grace period for each phase of the protocol\n     * @param phaseMessages the map of phase messages published so far\n     * @return the transition\n     */\n    public Transition onNext(\n            @NonNull final WrapsMessagePublication publication,\n            @NonNull final WrapsPhase currentPhase,\n            @NonNull final RosterTransitionWeights weights,\n            @NonNull final Duration gracePeriod,\n            @NonNull final Map<WrapsPhase, SortedMap<Long, WrapsMessagePublication>> phaseMessages) {\n        requireNonNull(publication);\n        requireNonNull(currentPhase);\n        requireNonNull(weights);\n        requireNonNull(gracePeriod);\n        requireNonNull(phaseMessages);\n        // The final phase involves publishing votes, not messages, so abort\n        if (currentPhase == AGGREGATE) {\n            return Transition.rejectedAt(AGGREGATE);\n        }\n        // Otherwise the phase should match the current phase\n        if (publication.phase() != currentPhase) {\n            return Transition.rejectedAt(currentPhase);\n        }\n        final var messages = phaseMessages.computeIfAbsent(currentPhase, p -> new TreeMap<>());\n        if (currentPhase == R1) {\n            if (messages.putIfAbsent(publication.nodeId(), publication) != null) {\n                return Transition.rejectedAt(currentPhase);\n            }\n            final long r1Weight = messages.values().stream()\n                    .mapToLong(p -> weights.sourceWeightOf(p.nodeId()))\n                    .sum();\n            if (r1Weight >= moreThanHalfOfTotal(weights.sourceNodeWeights())) {\n                return Transition.advanceTo(R2, publication.receiptTime().plus(gracePeriod));\n            }\n        } else {\n            final var r1Nodes = phaseMessages.get(R1).keySet();\n            if (!r1Nodes.contains(publication.nodeId())) {\n                return Transition.rejectedAt(currentPhase);\n            }\n            if (messages.putIfAbsent(publication.nodeId(), publication) != null) {\n                return Transition.rejectedAt(currentPhase);\n            }\n            if (messages.keySet().containsAll(r1Nodes)) {\n                final var nextPhase = currentPhase == R2 ? R3 : AGGREGATE;\n                final var nextGracePeriodEndTime =\n                        currentPhase == R2 ? publication.receiptTime().plus(gracePeriod) : null;\n                return Transition.advanceTo(nextPhase, nextGracePeriodEndTime);\n            }\n        }\n        return Transition.incorporatedIn(currentPhase);\n    }\n}\n","numLines":127,"startLine":1,"totalLines":127}}}
+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KQ6FXtZ1y3fiwQo8fW9tFv","type":"tool_result","content":"1\t// SPDX-License-Identifier: Apache-2.0\n2\tpackage com.hedera.node.app.history.impl;\n3\t\n4\timport static com.hedera.hapi.node.state.history.WrapsPhase.AGGREGATE;\n5\timport static com.hedera.hapi.node.state.history.WrapsPhase.POST_AGGREGATION;\n6\timport static com.hedera.hapi.node.state.history.WrapsPhase.R1;\n7\timport static com.hedera.hapi.node.state.history.WrapsPhase.R2;\n8\timport static com.hedera.hapi.node.state.history.WrapsPhase.R3;\n9\timport static com.hedera.hapi.util.HapiUtils.asInstant;\n10\timport static com.hedera.node.app.hapi.utils.CommonUtils.noThrowSha384HashOf;\n11\timport static com.hedera.node.app.history.HistoryLibrary.MISSING_SCHNORR_KEY;\n12\timport static com.hedera.node.app.history.impl.WrapsMpcStateMachine.POST_MPC_PHASES;\n13\timport static java.util.Collections.emptySortedMap;\n14\timport static java.util.Objects.requireNonNull;\n15\timport static java.util.concurrent.TimeUnit.MILLISECONDS;\n16\t\n17\timport com.hedera.hapi.node.state.history.AggregatedNodeSignatures;\n18\timport com.hedera.hapi.node.state.history.ChainOfTrustProof;\n19\timport com.hedera.hapi.node.state.history.History;\n20\timport com.hedera.hapi.node.state.history.HistoryProof;\n21\timport com.hedera.hapi.node.state.history.HistoryProofConstruction;\n22\timport com.hedera.hapi.node.state.history.HistoryProofVote;\n23\timport com.hedera.hapi.node.state.history.WrapsPhase;\n24\timport com.hedera.hapi.node.state.history.WrapsSigningState;\n25\timport com.hedera.node.app.history.HistoryLibrary;\n26\timport com.hedera.node.app.history.HistoryLibrary.AddressBook;\n27\timport com.hedera.node.app.history.ReadableHistoryStore.WrapsMessagePublication;\n28\timport com.hedera.node.app.history.WritableHistoryStore;\n29\timport com.hedera.node.app.history.impl.ProofKeysAccessorImpl.SchnorrKeyPair;\n30\timport com.hedera.node.app.service.roster.impl.RosterTransitionWeights;\n31\timport com.hedera.node.config.data.TssConfig;\n32\timport com.hedera.pbj.runtime.io.buffer.Bytes;\n33\timport edu.umd.cs.findbugs.annotations.NonNull;\n34\timport edu.umd.cs.findbugs.annotations.Nullable;\n35\timport java.security.SecureRandom;\n36\timport java.time.Duration;\n37\timport java.time.Instant;\n38\timport java.util.ArrayList;\n39\timport java.util.EnumMap;\n40\timport java.util.HashMap;\n41\timport java.util.List;\n42\timport java.util.Map;\n43\timport java.util.SortedMap;\n44\timport java.util.TreeSet;\n45\timport java.util.concurrent.CompletableFuture;\n46\timport java.util.concurrent.Executor;\n47\timport java.util.concurrent.TimeUnit;\n48\timport java.util.function.Consumer;\n49\timport org.apache.logging.log4j.LogManager;\n50\timport org.apache.logging.log4j.Logger;\n51\t\n52\t/**\n53\t * A {@link HistoryProver} that uses the WRAPS protocol to construct a {@link HistoryProof} that uses a\n54\t * {@link ChainOfTrustProof#wrapsProof()} to establish chain of trust from the genesis address book hash.\n55\t * The state machine moves first through a signing protocol that forms an aggregate signature from three\n56\t * rounds of exchanging WRAPS messages; and then runs a heavy compression step to form a succinct proof.\n57\t */\n58\tpublic class WrapsHistoryProver implements HistoryProver {\n59\t    private static final Logger log = LogManager.getLogger(WrapsHistoryProver.class);\n60\t    public static final String MISSING_MESSAGES_FAILURE_PREFIX = \"Still missing messages from R1 nodes \";\n61\t    public static final String WRAPS_NOT_READY_FAILURE_PREFIX = \"WRAPS library is not ready\";\n62\t    public static final String LEDGER_ID_NOT_READY_FAILURE_PREFIX = \"Ledger id is not yet available\";\n63\t\n64\t    private final long selfId;\n65\t    private final Duration wrapsMessageGracePeriod;\n66\t    private final SchnorrKeyPair schnorrKeyPair;\n67\t    private final Map<Long, Bytes> proofKeys;\n68\t    private final RosterTransitionWeights weights;\n69\t    private final Delayer delayer;\n70\t    private final Executor executor;\n71\t\n72\t    @Nullable\n73\t    private final HistoryProof sourceProof;\n74\t\n75\t    private final HistoryLibrary historyLibrary;\n76\t    private final HistorySubmissions submissions;\n77\t    private final WrapsMpcStateMachine machine;\n78\t    private final Object voteLock = new Object();\n79\t\n80\t    private final Map<WrapsPhase, SortedMap<Long, WrapsMessagePublication>> phaseMessages =\n81\t            new EnumMap<>(WrapsPhase.class);\n82\t    private final Map<Long, Bytes> explicitHistoryProofHashes = new HashMap<>();\n83\t\n84\t    /**\n85\t     * If non-null, the phase whose last publish returned a WRAPS-not-ready noop;\n86\t     * cleared at the next publishIfNeeded so the publish is retried.\n87\t     */\n88\t    @Nullable\n89\t    private volatile WrapsPhase phaseNeedingWrapsReadinessRetry;\n90\t\n91\t    /**\n92\t     * If not null, the WRAPS message being signed for the current construction.\n93\t     */\n94\t    @Nullable\n95\t    private byte[] wrapsMessage;\n96\t\n97\t    /**\n98\t     * If not null, the target address book being added to the chain of trust.\n99\t     */\n100\t    @Nullable\n101\t    private AddressBook targetAddressBook;\n102\t\n103\t    /**\n104\t     * If not null, the hash of the target address book.\n105\t     */\n106\t    @Nullable\n107\t    private byte[] targetAddressBookHash;\n108\t\n109\t    /**\n110\t     * If non-null, the entropy used to generate the R1 message. (If this node rejoins the network\n111\t     * after a restart, having lost its entropy, it cannot continue and the protocol will time out.)\n112\t     */\n113\t    @Nullable\n114\t    private byte[] entropy;\n115\t\n116\t    /**\n117\t     * Future that resolves on submission of this node's R1 signing message.\n118\t     */\n119\t    @Nullable\n120\t    private CompletableFuture<Void> r1Future;\n121\t\n122\t    /**\n123\t     * Future that resolves on submission of this node's R2 signing message.\n124\t     */\n125\t    @Nullable\n126\t    private CompletableFuture<Void> r2Future;\n127\t\n128\t    /**\n129\t     * Future that resolves on submission of this node's R3 signing message.\n130\t     */\n131\t    @Nullable\n132\t    private CompletableFuture<Void> r3Future;\n133\t\n134\t    /**\n135\t     * If non-null, the history proof we have constructed (recursive or otherwise).\n136\t     */\n137\t    @Nullable\n138\t    private HistoryProof historyProof;\n139\t\n140\t    /**\n141\t     * Future that resolves on the completion of the proof vote decision post-jitter.\n142\t     */\n143\t    @Nullable\n144\t    private CompletableFuture<VoteDecision> voteDecisionFuture;\n145\t\n146\t    /**\n147\t     * Future that resolves on submission of this node's vote for proof.\n148\t     */\n149\t    @Nullable\n150\t    private volatile CompletableFuture<Void> voteFuture;\n151\t\n152\t    /**\n153\t     * The kind of proof work associated with {@link #voteFuture}; this is set while either computing or voting on it.\n154\t     */\n155\t    @Nullable\n156\t    private ProofKind voteFutureKind;\n157\t\n158\t    /**\n159\t     * If non-null, a node whose explicit recursive proof has already been validated.\n160\t     */\n161\t    @Nullable\n162\t    private Long validRecursiveProofNodeId;\n163\t\n164\t    private boolean nonRecursiveProofFinalized;\n165\t    private boolean recursiveProofFinalized;\n166\t\n167\t    /**\n168\t     * The current WRAPS phase; starts with R1 and advances as messages are received.\n169\t     */\n170\t    private WrapsPhase wrapsPhase = R1;\n171\t\n172\t    /**\n173\t     * Indicates this prover's construction has been canceled and any post-output work should be skipped.\n174\t     */\n175\t    private volatile boolean constructionCanceled = false;\n176\t\n177\t    private sealed interface WrapsPhaseOutput\n178\t            permits NoopOutput, MessagePhaseOutput, ProofPhaseOutput, AggregatePhaseOutput {}\n179\t\n180\t    private record NoopOutput(String reason) implements WrapsPhaseOutput {}\n181\t\n182\t    private record MessagePhaseOutput(byte[] message) implements WrapsPhaseOutput {}\n183\t\n184\t    private record AggregatePhaseOutput(byte[] signature, List<Long> nodeIds) implements WrapsPhaseOutput {}\n185\t\n186\t    private record ProofPhaseOutput(byte[] compressed, byte[] uncompressed) implements WrapsPhaseOutput {\n187\t        @NonNull\n188\t        @Override\n189\t        public String toString() {\n190\t            return \"WRAPS{compressed=\"\n191\t                    + compressed.length\n192\t                    + \" bytes (\" + Bytes.wrap(noThrowSha384HashOf(compressed)) + \"), \" + \"uncompressed=\"\n193\t                    + uncompressed.length\n194\t                    + \" bytes (\" + Bytes.wrap(noThrowSha384HashOf(uncompressed)) + \")\"\n195\t                    + \"}\";\n196\t        }\n197\t    }\n198\t\n199\t    private enum VoteChoice {\n200\t        SUBMIT,\n201\t        SKIP\n202\t    }\n203\t\n204\t    private enum ProofKind {\n205\t        NON_RECURSIVE,\n206\t        RECURSIVE\n207\t    }\n208\t\n209\t    private record VoteDecision(VoteChoice choice, @Nullable Long congruentNodeId) {\n210\t        static VoteDecision explicit() {\n211\t            return new VoteDecision(VoteChoice.SUBMIT, null);\n212\t        }\n213\t\n214\t        static VoteDecision skip() {\n215\t            return new VoteDecision(VoteChoice.SKIP, null);\n216\t        }\n217\t\n218\t        static VoteDecision congruent(long nodeId) {\n219\t            return new VoteDecision(VoteChoice.SUBMIT, nodeId);\n220\t        }\n221\t    }\n222\t\n223\t    public interface Delayer {\n224\t        @NonNull\n225\t        Executor delayedExecutor(long delay, @NonNull TimeUnit unit, @NonNull Executor executor);\n226\t    }\n227\t\n228\t    public WrapsHistoryProver(\n229\t            final long selfId,\n230\t            @NonNull final Duration wrapsMessageGracePeriod,\n231\t            @NonNull final SchnorrKeyPair schnorrKeyPair,\n232\t            @Nullable final HistoryProof sourceProof,\n233\t            @NonNull final RosterTransitionWeights weights,\n234\t            @NonNull final Map<Long, Bytes> proofKeys,\n235\t            @NonNull final Delayer delayer,\n236\t            @NonNull final Executor executor,\n237\t            @NonNull final HistoryLibrary historyLibrary,\n238\t            @NonNull final HistorySubmissions submissions,\n239\t            @NonNull final WrapsMpcStateMachine machine) {\n240\t        this.selfId = selfId;\n241\t        this.sourceProof = sourceProof;\n242\t        this.wrapsMessageGracePeriod = requireNonNull(wrapsMessageGracePeriod);\n243\t        this.schnorrKeyPair = requireNonNull(schnorrKeyPair);\n244\t        this.weights = requireNonNull(weights);\n245\t        this.proofKeys = requireNonNull(proofKeys);\n246\t        this.delayer = requireNonNull(delayer);\n247\t        this.executor = requireNonNull(executor);\n248\t        this.historyLibrary = requireNonNull(historyLibrary);\n249\t        this.submissions = requireNonNull(submissions);\n250\t        this.machine = requireNonNull(machine);\n251\t    }\n252\t\n253\t    @NonNull\n254\t    @Override\n255\t    public Outcome advance(\n256\t            @NonNull final Instant now,\n257\t            @NonNull final HistoryProofConstruction construction,\n258\t            @NonNull final Bytes targetMetadata,\n259\t            @NonNull final Map<Long, Bytes> targetProofKeys,\n260\t            @NonNull final TssConfig tssConfig,\n261\t            @Nullable final Bytes ledgerId,\n262\t            final boolean canSubmit) {\n263\t        requireNonNull(now);\n264\t        requireNonNull(construction);\n265\t        requireNonNull(targetMetadata);\n266\t        requireNonNull(targetProofKeys);\n267\t        requireNonNull(tssConfig);\n268\t        if (ledgerId == null && sourceProof != null) {\n269\t            return new Outcome.Failed(\"Only genesis WRAPS proofs are allowed to not have a ledger id\");\n270\t        }\n271\t        final var state = construction.wrapsSigningStateOrElse(WrapsSigningState.DEFAULT);\n272\t        if (state.phase() != AGGREGATE\n273\t                && state.hasGracePeriodEndTime()\n274\t                && now.isAfter(asInstant(state.gracePeriodEndTimeOrThrow()))) {\n275\t            final var submittingNodes =\n276\t                    phaseMessages.getOrDefault(state.phase(), emptySortedMap()).keySet();\n277\t            // If we reached a stage with a grace period, we must have at least one R1 message, so no getOrDefault()\n278\t            final var missingNodes = phaseMessages.get(R1).keySet().stream()\n279\t                    .filter(nodeId -> !submittingNodes.contains(nodeId))\n280\t                    .toList();\n281\t            return new Outcome.Failed(MISSING_MESSAGES_FAILURE_PREFIX + missingNodes\n282\t                    + \" after end of grace period for phase \" + state.phase());\n283\t        } else {\n284\t            if (!canSubmit) {\n285\t                return Outcome.InProgress.INSTANCE;\n286\t            }\n287\t            if (wrapsMessage == null) {\n288\t                // Avoid caching a partial derived state if one of these computations throws.\n289\t                final var computedTargetAddressBook =\n290\t                        AddressBook.from(weights.targetNodeWeights(), nodeId -> targetProofKeys\n291\t                                .getOrDefault(nodeId, MISSING_SCHNORR_KEY)\n292\t                                .toByteArray());\n293\t                final var computedWrapsMessage =\n294\t                        historyLibrary.computeWrapsMessage(computedTargetAddressBook, targetMetadata.toByteArray());\n295\t                final var computedTargetAddressBookHash = historyLibrary.hashAddressBook(computedTargetAddressBook);\n296\t                targetAddressBook = computedTargetAddressBook;\n297\t                wrapsMessage = computedWrapsMessage;\n298\t                targetAddressBookHash = computedTargetAddressBookHash;\n299\t            }\n300\t            final var effectivePhase = construction.hasTargetProof() ? POST_AGGREGATION : state.phase();\n301\t            publishIfNeeded(\n302\t                    construction.constructionId(),\n303\t                    effectivePhase,\n304\t                    targetMetadata,\n305\t                    targetProofKeys,\n306\t                    tssConfig,\n307\t                    ledgerId,\n308\t                    construction.targetProof());\n309\t        }\n310\t        return Outcome.InProgress.INSTANCE;\n311\t    }\n312\t\n313\t    public static boolean isRecoverableFailure(@NonNull final String reason) {\n314\t        requireNonNull(reason);\n315\t        return reason.startsWith(MISSING_MESSAGES_FAILURE_PREFIX);\n316\t    }\n317\t\n318\t    @Override\n319\t    public boolean addWrapsSigningMessage(\n320\t            final long constructionId,\n321\t            @NonNull final WrapsMessagePublication publication,\n322\t            @NonNull final WritableHistoryStore writableHistoryStore) {\n323\t        requireNonNull(publication);\n324\t        requireNonNull(writableHistoryStore);\n325\t        return receiveWrapsSigningMessage(constructionId, publication, writableHistoryStore);\n326\t    }\n327\t\n328\t    @Override\n329\t    public void replayWrapsSigningMessage(long constructionId, @NonNull WrapsMessagePublication publication) {\n330\t        receiveWrapsSigningMessage(constructionId, publication, null);\n331\t    }\n332\t\n333\t    @Override\n334\t    public void observeProofVote(\n335\t            final long nodeId,\n336\t            @NonNull final HistoryProofVote vote,\n337\t            final boolean proofFinalized,\n338\t            @NonNull final ProofVoteCategory proofVoteCategory) {\n339\t        requireNonNull(vote);\n340\t        requireNonNull(proofVoteCategory);\n341\t        if (proofFinalized) {\n342\t            log.info(\"Observed finalized proof via node{}; skipping vote\", nodeId);\n343\t            final var proofKind = proofKindOf(proofVoteCategory);\n344\t            final CompletableFuture<VoteDecision> decisionFuture;\n345\t            synchronized (voteLock) {\n346\t                markFinalized(proofKind);\n347\t                decisionFuture = voteFutureKind == null || voteFutureKind == proofKind ? voteDecisionFuture : null;\n348\t                if (decisionFuture != null) {\n349\t                    voteDecisionFuture = null;\n350\t                }\n351\t                if (voteFutureKind == proofKind) {\n352\t                    voteFuture = null;\n353\t                    voteFutureKind = null;\n354\t                }\n355\t            }\n356\t            if (decisionFuture != null) {\n357\t                decisionFuture.complete(VoteDecision.skip());\n358\t            }\n359\t            return;\n360\t        }\n361\t        // Explicit vote case\n362\t        if (vote.hasProof()) {\n363\t            final var proof = vote.proofOrElse(HistoryProof.DEFAULT);\n364\t            switch (proofVoteCategory) {\n365\t                case NOT_RECURSIVE -> {\n366\t                    // Always store a hash – useful if we haven't finished our own proof yet\n367\t                    final var hash = hashOf(proof);\n368\t                    final CompletableFuture<VoteDecision> decisionFuture;\n369\t                    synchronized (voteLock) {\n370\t                        explicitHistoryProofHashes.put(nodeId, hash);\n371\t                        // If we already have our proof, see if it matches; save a few bytes by using congruent vote\n372\t                        decisionFuture = (voteFutureKind == null || voteFutureKind == ProofKind.NON_RECURSIVE)\n373\t                                        && historyProof != null\n374\t                                        && selfProofHashOrThrow().equals(hash)\n375\t                                ? voteDecisionFuture\n376\t                                : null;\n377\t                    }\n378\t                    if (decisionFuture != null && decisionFuture.complete(VoteDecision.congruent(nodeId))) {\n379\t                        log.info(\"Observed matching explicit proof from node{}; voting congruent instead\", nodeId);\n380\t                    }\n381\t                }\n382\t                case VALID_RECURSIVE -> {\n383\t                    // This is the big win, avoiding an explicit vote for the megabyte-scale WRAPS proof\n384\t                    final CompletableFuture<VoteDecision> decisionFuture;\n385\t                    synchronized (voteLock) {\n386\t                        validRecursiveProofNodeId = nodeId;\n387\t                        decisionFuture = voteFutureKind == null || voteFutureKind == ProofKind.RECURSIVE\n388\t                                ? voteDecisionFuture\n389\t                                : null;\n390\t                    }\n391\t                    if (decisionFuture != null && decisionFuture.complete(VoteDecision.congruent(nodeId))) {\n392\t                        log.info(\n393\t                                \"Observed valid explicit recursive proof from node{}; voting congruent instead\",\n394\t                                nodeId);\n395\t                    }\n396\t                }\n397\t                case INVALID_RECURSIVE -> {\n398\t                    // No-op, an invalid proof obviously has no use for us\n399\t                }\n400\t            }\n401\t        }\n402\t    }\n403\t\n404\t    @Override\n405\t    public boolean cancelPendingWork() {\n406\t        constructionCanceled = true;\n407\t        final var sb = new StringBuilder(\"Canceled work on WRAPS prover\");\n408\t        boolean canceledSomething = false;\n409\t        if (r1Future != null && !r1Future.isDone()) {\n410\t            sb.append(\"\\n  * In-flight R1 future\");\n411\t            r1Future.cancel(true);\n412\t            canceledSomething = true;\n413\t        }\n414\t        if (r2Future != null && !r2Future.isDone()) {\n415\t            sb.append(\"\\n  * In-flight R2 future\");\n416\t            r2Future.cancel(true);\n417\t            canceledSomething = true;\n418\t        }\n419\t        if (r3Future != null && !r3Future.isDone()) {\n420\t            sb.append(\"\\n  * In-flight R3 future\");\n421\t            r3Future.cancel(true);\n422\t            canceledSomething = true;\n423\t        }\n424\t        if (voteFuture != null && !voteFuture.isDone()) {\n425\t            sb.append(\"\\n  * In-flight vote future\");\n426\t            voteFuture.cancel(true);\n427\t            canceledSomething = true;\n428\t        }\n429\t        if (canceledSomething) {\n430\t            log.info(sb.toString());\n431\t        }\n432\t        return canceledSomething;\n433\t    }\n434\t\n435\t    private boolean receiveWrapsSigningMessage(\n436\t            final long constructionId,\n437\t            @NonNull final WrapsMessagePublication publication,\n438\t            @Nullable final WritableHistoryStore writableHistoryStore) {\n439\t        if (MISSING_SCHNORR_KEY.equals(proofKeys.getOrDefault(publication.nodeId(), MISSING_SCHNORR_KEY))) {\n440\t            // If a node did not publish its Schnorr key in time to make it into the source roster,\n441\t            // we ignore any WRAPS message it publishes later after coming online\n442\t            return false;\n443\t        }\n444\t        final var transition = machine.onNext(publication, wrapsPhase, weights, wrapsMessageGracePeriod, phaseMessages);\n445\t        log.info(\n446\t                \"Received {} message from node{} for construction #{} in phase={}) -> {} (new phase={})\",\n447\t                publication.phase(),\n448\t                publication.nodeId(),\n449\t                constructionId,\n450\t                wrapsPhase,\n451\t                transition.publicationAccepted() ? \"accepted\" : \"rejected\",\n452\t                transition.newCurrentPhase());\n453\t        if (transition.publicationAccepted()) {\n454\t            if (transition.newCurrentPhase() != wrapsPhase) {\n455\t                wrapsPhase = transition.newCurrentPhase();\n456\t                log.info(\"Advanced to {} for construction #{}\", wrapsPhase, constructionId);\n457\t                if (writableHistoryStore != null) {\n458\t                    writableHistoryStore.advanceWrapsSigningPhase(\n459\t                            constructionId, wrapsPhase, transition.gracePeriodEndTimeUpdate());\n460\t                }\n461\t            }\n462\t            return true;\n463\t        }\n464\t        return false;\n465\t    }\n466\t\n467\t    /**\n468\t     * Ensures this node has published its WRAPS message or aggregate signature vote.\n469\t     */\n470\t    private void publishIfNeeded(\n471\t            final long constructionId,\n472\t            @NonNull final WrapsPhase phase,\n473\t            @NonNull final Bytes targetMetadata,\n474\t            @NonNull final Map<Long, Bytes> targetProofKeys,\n475\t            @NonNull final TssConfig tssConfig,\n476\t            @Nullable final Bytes ledgerId,\n477\t            @Nullable final HistoryProof aggregatedSignatureProof) {\n478\t        if (shouldSkipAfterCancellation(constructionId, phase)) {\n479\t            return;\n480\t        }\n481\t        final boolean isWrapsReadinessRetry = phase == phaseNeedingWrapsReadinessRetry;\n482\t        if (isWrapsReadinessRetry) {\n483\t            consumerOf(phase).accept(null);\n484\t            phaseNeedingWrapsReadinessRetry = null;\n485\t        }\n486\t        // Skip building sourceBook/proofKeyList/chained futures while the WRAPS library is still loading.\n487\t        final boolean needsWrapsForOutput =\n488\t                phase == POST_AGGREGATION || (phase == AGGREGATE && sourceProof != null && tssConfig.wrapsEnabled());\n489\t        // The genesis proof also needs the ledger id, which is not established at the instant the library\n490\t        // becomes ready; without this the phase proceeds and dereferences a null ledgerId.\n491\t        final String notReadyReason;\n492\t        if (!needsWrapsForOutput) {\n493\t            notReadyReason = null;\n494\t        } else if (!historyLibrary.wrapsProverReady(tssConfig.wrapsProvingKeyHash())) {\n495\t            notReadyReason = \"WRAPS library is not ready\";\n496\t        } else if (phase == POST_AGGREGATION && ledgerId == null) {\n497\t            notReadyReason = \"ledger id is not yet available\";\n498\t        } else {\n499\t            notReadyReason = null;\n500\t        }\n501\t        if (notReadyReason != null) {\n502\t            if (isWrapsReadinessRetry) {\n503\t                log.debug(\"Deferring {} output for construction #{}: {}\", phase, constructionId, notReadyReason);\n504\t            } else {\n505\t                log.info(\n506\t                        \"Deferring {} output for construction #{}: {} (will retry each consensus round until ready)\",\n507\t                        phase,\n508\t                        constructionId,\n509\t                        notReadyReason);\n510\t            }\n511\t            phaseNeedingWrapsReadinessRetry = phase;\n512\t            return;\n513\t        }\n514\t        if (futureOf(phase) == null\n515\t                && (POST_MPC_PHASES.contains(phase)\n516\t                        || !phaseMessages.getOrDefault(phase, emptySortedMap()).containsKey(selfId))) {\n517\t            if (isWrapsReadinessRetry) {\n518\t                log.debug(\n519\t                        \"Re-attempting publication of {} output on construction #{} after a WRAPS-not-ready noop\",\n520\t                        phase,\n521\t                        constructionId);\n522\t            } else if (phase == POST_AGGREGATION) {\n523\t                log.info(\"Considering publication of vote for genesis WRAPS proof on construction #{}\", constructionId);\n524\t            } else {\n525\t                log.info(\"Considering publication of WRAPS {} output on construction #{}\", phase, constructionId);\n526\t            }\n527\t            final var sourceBook = AddressBook.from(weights.sourceNodeWeights(), nodeId -> proofKeys\n528\t                    .getOrDefault(nodeId, MISSING_SCHNORR_KEY)\n529\t                    .toByteArray());\n530\t            final var targetBook = requireNonNull(targetAddressBook);\n531\t            final var targetBookHash = requireNonNull(targetAddressBookHash);\n532\t            final var proofKeyList = proofKeyListFrom(targetProofKeys);\n533\t            consumerOf(phase)\n534\t                    .accept(outputFuture(\n535\t                                    phase,\n536\t                                    tssConfig,\n537\t                                    ledgerId,\n538\t                                    sourceBook,\n539\t                                    targetBook,\n540\t                                    targetMetadata,\n541\t                                    aggregatedSignatureProof)\n542\t                            .thenAcceptAsync(\n543\t                                    output -> {\n544\t                                        if (output == null) {\n545\t                                            if (phase == R1 || POST_MPC_PHASES.contains(phase)) {\n546\t                                                log.warn(\"Got null output for {} phase, skipping publication\", phase);\n547\t                                            }\n548\t                                            return;\n549\t                                        }\n550\t                                        if (shouldSkipAfterCancellation(constructionId, phase)) {\n551\t                                            return;\n552\t                                        }\n553\t                                        switch (output) {\n554\t                                            case MessagePhaseOutput messageOutput -> {\n555\t                                                if (shouldSkipAfterCancellation(constructionId, phase)) {\n556\t                                                    return;\n557\t                                                }\n558\t                                                final var wrapsMessage = Bytes.wrap(messageOutput.message());\n559\t                                                submissions\n560\t                                                        .submitWrapsSigningMessage(phase, wrapsMessage, constructionId)\n561\t                                                        .join();\n562\t                                            }\n563\t                                            case AggregatePhaseOutput aggregatePhaseOutput -> {\n564\t                                                // We are doing a non-recursive proof via an aggregate signature\n565\t                                                final var aggregatedNodeSignatures = new AggregatedNodeSignatures(\n566\t                                                        Bytes.wrap(aggregatePhaseOutput.signature()),\n567\t                                                        new ArrayList<>(phaseMessages\n568\t                                                                .get(R1)\n569\t                                                                .keySet()),\n570\t                                                        targetMetadata);\n571\t                                                final var proof = HistoryProof.newBuilder()\n572\t                                                        .targetProofKeys(proofKeyList)\n573\t                                                        .targetHistory(\n574\t                                                                new History(Bytes.wrap(targetBookHash), targetMetadata))\n575\t                                                        .chainOfTrustProof(ChainOfTrustProof.newBuilder()\n576\t                                                                .aggregatedNodeSignatures(aggregatedNodeSignatures))\n577\t                                                        .build();\n578\t                                                scheduleVoteWithJitter(constructionId, tssConfig, proof);\n579\t                                            }\n580\t                                            case ProofPhaseOutput proofOutput -> {\n581\t                                                // We have a WRAPS proof\n582\t                                                final var recursiveProof = Bytes.wrap(proofOutput.compressed());\n583\t                                                final var uncompressedProof = Bytes.wrap(proofOutput.uncompressed());\n584\t                                                final var proof = HistoryProof.newBuilder()\n585\t                                                        .targetProofKeys(proofKeyList)\n586\t                                                        .targetHistory(\n587\t                                                                new History(Bytes.wrap(targetBookHash), targetMetadata))\n588\t                                                        .chainOfTrustProof(ChainOfTrustProof.newBuilder()\n589\t                                                                .wrapsProof(recursiveProof))\n590\t                                                        .uncompressedWrapsProof(uncompressedProof)\n591\t                                                        .build();\n592\t                                                scheduleVoteWithJitter(constructionId, tssConfig, proof);\n593\t                                            }\n594\t                                            case NoopOutput noopOutput -> {\n595\t                                                if (WRAPS_NOT_READY_FAILURE_PREFIX.equals(noopOutput.reason())\n596\t                                                        || LEDGER_ID_NOT_READY_FAILURE_PREFIX.equals(\n597\t                                                                noopOutput.reason())) {\n598\t                                                    // Flag instead of clearing voteFuture inline; the outer accept()\n599\t                                                    // hasn't returned yet.\n600\t                                                    log.debug(\n601\t                                                            \"Deferring {} output: {} (will retry next round)\",\n602\t                                                            phase,\n603\t                                                            noopOutput.reason());\n604\t                                                    phaseNeedingWrapsReadinessRetry = phase;\n605\t                                                } else {\n606\t                                                    log.info(\n607\t                                                            \"Skipping publication of {} output: {}\",\n608\t                                                            phase,\n609\t                                                            noopOutput.reason());\n610\t                                                }\n611\t                                            }\n612\t                                        }\n613\t                                    },\n614\t                                    executor)\n615\t                            .exceptionally(e -> {\n616\t                                log.error(\n617\t                                        \"Failed to publish WRAPS {} message for construction #{}\",\n618\t                                        phase,\n619\t                                        constructionId,\n620\t                                        e);\n621\t                                return null;\n622\t                            }));\n623\t        }\n624\t    }\n625\t\n626\t    private void scheduleVoteWithJitter(\n627\t            final long constructionId, @NonNull final TssConfig tssConfig, @NonNull final HistoryProof proof) {\n628\t        if (constructionCanceled) {\n629\t            log.info(\"Skipping vote scheduling on canceled construction #{}\", constructionId);\n630\t            return;\n631\t        }\n632\t        final var proofKind = proofKindOf(proof);\n633\t        final var selfProofHash = hashOf(proof);\n634\t        final var decisionFuture = new CompletableFuture<VoteDecision>();\n635\t        final var submissionFuture = decisionFuture.thenCompose(decision -> switch (decision.choice()) {\n636\t            case SKIP -> CompletableFuture.completedFuture(null);\n637\t            case SUBMIT -> {\n638\t                final var congruentNodeId = decision.congruentNodeId();\n639\t                if (congruentNodeId != null) {\n640\t                    log.info(\n641\t                            \"Submitting congruent vote to node{} for construction #{}\",\n642\t                            congruentNodeId,\n643\t                            constructionId);\n644\t                    yield submissions.submitCongruentProofVote(constructionId, congruentNodeId);\n645\t                } else {\n646\t                    log.info(\"Submitting explicit proof vote for construction #{}\", constructionId);\n647\t                    yield submissions.submitExplicitProofVote(constructionId, proof);\n648\t                }\n649\t            }\n650\t        });\n651\t        final VoteDecision immediateDecision;\n652\t        synchronized (voteLock) {\n653\t            if (constructionCanceled || isFinalized(proofKind)) {\n654\t                log.info(\n655\t                        \"Skipping {} proof vote scheduling on finalized construction #{}\",\n656\t                        proofKind == ProofKind.RECURSIVE ? \"recursive\" : \"non-recursive\",\n657\t                        constructionId);\n658\t                return;\n659\t            }\n660\t            this.historyProof = proof;\n661\t            immediateDecision = immediateDecisionFor(proofKind, selfProofHash);\n662\t            voteDecisionFuture = decisionFuture;\n663\t            voteFuture = submissionFuture;\n664\t            voteFutureKind = proofKind;\n665\t        }\n666\t        if (immediateDecision != null) {\n667\t            if (immediateDecision.congruentNodeId() != null) {\n668\t                log.info(\n669\t                        \"Already observed usable explicit proof from node{}; voting congruent immediately\",\n670\t                        immediateDecision.congruentNodeId());\n671\t            }\n672\t            decisionFuture.complete(immediateDecision);\n673\t            return;\n674\t        }\n675\t\n676\t        final long jitterMs = computeJitterMs(tssConfig, constructionId);\n677\t        final var delayed = delayer.delayedExecutor(jitterMs, MILLISECONDS, executor);\n678\t\n679\t        // If this is the first thread to complete the vote decision, we submit an explicit vote\n680\t        CompletableFuture.runAsync(() -> decisionFuture.complete(VoteDecision.explicit()), delayed);\n681\t    }\n682\t\n683\t    @Nullable\n684\t    private VoteDecision immediateDecisionFor(@NonNull final ProofKind proofKind, @NonNull final Bytes selfProofHash) {\n685\t        if (proofKind == ProofKind.RECURSIVE) {\n686\t            return validRecursiveProofNodeId == null ? null : VoteDecision.congruent(validRecursiveProofNodeId);\n687\t        }\n688\t        for (final var entry : explicitHistoryProofHashes.entrySet()) {\n689\t            if (selfProofHash.equals(entry.getValue())) {\n690\t                return VoteDecision.congruent(entry.getKey());\n691\t            }\n692\t        }\n693\t        return null;\n694\t    }\n695\t\n696\t    private boolean isFinalized(@NonNull final ProofKind proofKind) {\n697\t        return proofKind == ProofKind.RECURSIVE ? recursiveProofFinalized : nonRecursiveProofFinalized;\n698\t    }\n699\t\n700\t    private void markFinalized(@NonNull final ProofKind proofKind) {\n701\t        if (proofKind == ProofKind.RECURSIVE) {\n702\t            recursiveProofFinalized = true;\n703\t        } else {\n704\t            nonRecursiveProofFinalized = true;\n705\t        }\n706\t    }\n707\t\n708\t    private boolean shouldSkipAfterCancellation(final long constructionId, @NonNull final WrapsPhase phase) {\n709\t        if (constructionCanceled) {\n710\t            log.info(\"Skipping post-output work for WRAPS {} on canceled construction #{}\", phase, constructionId);\n711\t            return true;\n712\t        }\n713\t        return false;\n714\t    }\n715\t\n716\t    private long computeJitterMs(@NonNull final TssConfig tssConfig, final long constructionId) {\n717\t        final var allNodes = new ArrayList<>(weights.targetNodeWeights().keySet());\n718\t        final int n = allNodes.size();\n719\t        final int selfIndex = allNodes.indexOf(selfId);\n720\t        final int leaderIndex = Math.floorMod((int) constructionId, n);\n721\t        final int rank = Math.floorMod(selfIndex - leaderIndex, n);\n722\t        return tssConfig.wrapsVoteJitterPerRank().toMillis() * rank;\n723\t    }\n724\t\n725\t    private CompletableFuture<WrapsPhaseOutput> outputFuture(\n726\t            @NonNull final WrapsPhase phase,\n727\t            @NonNull final TssConfig tssConfig,\n728\t            @Nullable final Bytes ledgerId,\n729\t            @NonNull final AddressBook sourceBook,\n730\t            @NonNull final AddressBook targetBook,\n731\t            @NonNull final Bytes targetMetadata,\n732\t            @Nullable final HistoryProof aggregatedSignatureProof) {\n733\t        final var message = requireNonNull(wrapsMessage);\n734\t        return CompletableFuture.supplyAsync(\n735\t                () -> switch (phase) {\n736\t                    case UNRECOGNIZED -> throw new IllegalArgumentException(\"Unrecognized phase\");\n737\t                    case R1 -> {\n738\t                        if (entropy == null) {\n739\t                            entropy = new byte[32];\n740\t                            new SecureRandom().nextBytes(entropy);\n741\t                            yield new MessagePhaseOutput(historyLibrary.runWrapsPhaseR1(\n742\t                                    entropy,\n743\t                                    message,\n744\t                                    schnorrKeyPair.privateKey().toByteArray()));\n745\t                        }\n746\t                        yield null;\n747\t                    }\n748\t                    case R2 -> {\n749\t                        if (entropy != null && phaseMessages.get(R1).containsKey(selfId)) {\n750\t                            yield new MessagePhaseOutput(historyLibrary.runWrapsPhaseR2(\n751\t                                    entropy,\n752\t                                    message,\n753\t                                    rawMessagesFor(R1),\n754\t                                    schnorrKeyPair.privateKey().toByteArray(),\n755\t                                    sourceBook,\n756\t                                    phaseMessages.get(R1).keySet()));\n757\t                        }\n758\t                        yield null;\n759\t                    }\n760\t                    case R3 -> {\n761\t                        if (entropy != null && phaseMessages.get(R1).containsKey(selfId)) {\n762\t                            yield new MessagePhaseOutput(historyLibrary.runWrapsPhaseR3(\n763\t                                    entropy,\n764\t                                    message,\n765\t                                    rawMessagesFor(R1),\n766\t                                    rawMessagesFor(R2),\n767\t                                    schnorrKeyPair.privateKey().toByteArray(),\n768\t                                    sourceBook,\n769\t                                    phaseMessages.get(R1).keySet()));\n770\t                        }\n771\t                        yield null;\n772\t                    }\n773\t                    case AGGREGATE -> {\n774\t                        final var signers = phaseMessages.get(R1).keySet();\n775\t                        final var signature = historyLibrary.runAggregationPhase(\n776\t                                message,\n777\t                                rawMessagesFor(R1),\n778\t                                rawMessagesFor(R2),\n779\t                                rawMessagesFor(R3),\n780\t                                sourceBook,\n781\t                                signers);\n782\t                        if (signature == null) {\n783\t                            yield new NoopOutput(\"WRAPS aggregation returned null for nodes \" + signers);\n784\t                        }\n785\t                        // Sans source proof, we are at genesis and need an aggregate signature proof right away\n786\t                        if (sourceProof == null || !tssConfig.wrapsEnabled()) {\n787\t                            final var isValid = historyLibrary.verifyAggregateSignature(\n788\t                                    message,\n789\t                                    sourceBook.nodeIds(),\n790\t                                    sourceBook.publicKeys(),\n791\t                                    sourceBook.weights(),\n792\t                                    signature);\n793\t                            if (!isValid) {\n794\t                                yield new NoopOutput(\"Invalid aggregate signature using nodes \" + signers);\n795\t                            }\n796\t                            yield new AggregatePhaseOutput(\n797\t                                    signature, signers.stream().toList());\n798\t                        } else {\n799\t                            if (!historyLibrary.wrapsProverReady(tssConfig.wrapsProvingKeyHash())) {\n800\t                                yield new NoopOutput(WRAPS_NOT_READY_FAILURE_PREFIX);\n801\t                            }\n802\t                            final var isValid = historyLibrary.verifyAggregateSignature(\n803\t                                    message,\n804\t                                    sourceBook.nodeIds(),\n805\t                                    sourceBook.publicKeys(),\n806\t                                    sourceBook.weights(),\n807\t                                    signature);\n808\t                            if (!isValid) {\n809\t                                yield new NoopOutput(\"Invalid aggregate signature using nodes \" + signers);\n810\t                            }\n811\t                            final long now = System.nanoTime();\n812\t                            log.info(\n813\t                                    \"\"\"\n814\t                                            Constructing incremental WRAPS proof with:\n815\t                                              ledgerId={}\n816\t                                              sourceBook={}\n817\t                                              sourceProofHash={}\n818\t                                              targetMetadata={}\n819\t                                              aggregateSignature={}\n820\t                                              signers={}\n821\t                                              targetBook={}\n822\t                                            \"\"\",\n823\t                                    ledgerId,\n824\t                                    sourceBook,\n825\t                                    noThrowSha384HashOf(sourceProof.uncompressedWrapsProof()),\n826\t                                    targetMetadata,\n827\t                                    Bytes.wrap(signature),\n828\t                                    signers,\n829\t                                    targetBook);\n830\t                            final var proof = historyLibrary.constructIncrementalWrapsProof(\n831\t                                    requireNonNull(ledgerId).toByteArray(),\n832\t                                    sourceProof.uncompressedWrapsProof().toByteArray(),\n833\t                                    sourceBook,\n834\t                                    targetBook,\n835\t                                    targetMetadata.toByteArray(),\n836\t                                    signature,\n837\t                                    signers);\n838\t                            if (proof == null) {\n839\t                                yield new NoopOutput(\"Incremental WRAPS proof construction returned null\");\n840\t                            }\n841\t                            final var output = new ProofPhaseOutput(proof.compressed(), proof.uncompressed());\n842\t                            logElapsed(\n843\t                                    constructionCanceled\n844\t                                            ? \"constructing canceled incremental WRAPS proof\"\n845\t                                            : \"constructing incremental WRAPS proof -> \" + output,\n846\t                                    now);\n847\t                            yield output;\n848\t                        }\n849\t                    }\n850\t                    case POST_AGGREGATION -> {\n851\t                        if (!historyLibrary.wrapsProverReady(tssConfig.wrapsProvingKeyHash())) {\n852\t                            yield new NoopOutput(WRAPS_NOT_READY_FAILURE_PREFIX);\n853\t                        }\n854\t                        if (ledgerId == null) {\n855\t                            yield new NoopOutput(LEDGER_ID_NOT_READY_FAILURE_PREFIX);\n856\t                        }\n857\t                        final var signature = requireNonNull(aggregatedSignatureProof)\n858\t                                .chainOfTrustProofOrThrow()\n859\t                                .aggregatedNodeSignaturesOrThrow()\n860\t                                .aggregatedSignature()\n861\t                                .toByteArray();\n862\t                        final var signers = new TreeSet<>(aggregatedSignatureProof\n863\t                                .chainOfTrustProofOrThrow()\n864\t                                .aggregatedNodeSignaturesOrThrow()\n865\t                                .signingNodeIds());\n866\t                        final long now = System.nanoTime();\n867\t                        log.info(\"\"\"\n868\t                                        Constructing genesis WRAPS proof with:\n869\t                                          ledgerId={}\n870\t                                          targetMetadata={}\n871\t                                          aggregateSignature={}\n872\t                                          signers={}\n873\t                                          targetBook={}\n874\t                                        \"\"\", ledgerId, targetMetadata, Bytes.wrap(signature), signers, targetBook);\n875\t                        final var proof = historyLibrary.constructGenesisWrapsProof(\n876\t                                requireNonNull(ledgerId).toByteArray(),\n877\t                                targetMetadata.toByteArray(),\n878\t                                signature,\n879\t                                signers,\n880\t                                targetBook);\n881\t                        if (proof == null) {\n882\t                            yield new NoopOutput(\"Genesis WRAPS proof construction returned null\");\n883\t                        }\n884\t                        final var output = new ProofPhaseOutput(proof.compressed(), proof.uncompressed());\n885\t                        logElapsed(\"constructing genesis WRAPS proof -> \" + output, now);\n886\t                        yield output;\n887\t                    }\n888\t                },\n889\t                executor);\n890\t    }\n891\t\n892\t    private void logElapsed(@NonNull final String event, final long startNs) {\n893\t        final var duration = Duration.ofNanos(System.nanoTime() - startNs);\n894\t        log.info(\"FINISHED {} - took {}m {}s\", event, duration.toMinutes(), duration.toSecondsPart());\n895\t    }\n896\t\n897\t    private byte[][] rawMessagesFor(@NonNull final WrapsPhase phase) {\n898\t        return phaseMessages.get(phase).values().stream()\n899\t                .map(WrapsMessagePublication::message)\n900\t                .map(Bytes::toByteArray)\n901\t                .toArray(byte[][]::new);\n902\t    }\n903\t\n904\t    private CompletableFuture<Void> futureOf(@NonNull final WrapsPhase phase) {\n905\t        return switch (phase) {\n906\t            case UNRECOGNIZED -> throw new IllegalArgumentException(\"Unrecognized phase\");\n907\t            case R1 -> r1Future;\n908\t            case R2 -> r2Future;\n909\t            case R3 -> r3Future;\n910\t            case AGGREGATE, POST_AGGREGATION -> voteFuture;\n911\t        };\n912\t    }\n913\t\n914\t    private Consumer<CompletableFuture<Void>> consumerOf(@NonNull final WrapsPhase phase) {\n915\t        return switch (phase) {\n916\t            case UNRECOGNIZED -> throw new IllegalArgumentException(\"Unrecognized phase\");\n917\t            case R1 -> f -> r1Future = f;\n918\t            case R2 -> f -> r2Future = f;\n919\t            case R3 -> f -> r3Future = f;\n920\t            case AGGREGATE -> f -> setVoteFuture(f, ProofKind.NON_RECURSIVE);\n921\t            case POST_AGGREGATION -> f -> setVoteFuture(f, ProofKind.RECURSIVE);\n922\t        };\n923\t    }\n924\t\n925\t    private void setVoteFuture(@Nullable final CompletableFuture<Void> future, @NonNull final ProofKind proofKind) {\n926\t        synchronized (voteLock) {\n927\t            voteFuture = future;\n928\t            voteFutureKind = future == null ? null : proofKind;\n929\t        }\n930\t    }\n931\t\n932\t    private Bytes selfProofHashOrThrow() {\n933\t        return explicitHistoryProofHashes.computeIfAbsent(selfId, k -> hashOf(requireNonNull(historyProof)));\n934\t    }\n935\t\n936\t    private static ProofKind proofKindOf(@NonNull final HistoryProof proof) {\n937\t        return proof.chainOfTrustProofOrElse(ChainOfTrustProof.DEFAULT).hasWrapsProof()\n938\t                ? ProofKind.RECURSIVE\n939\t                : ProofKind.NON_RECURSIVE;\n940\t    }\n941\t\n942\t    private static ProofKind proofKindOf(@NonNull final ProofVoteCategory category) {\n943\t        return category == ProofVoteCategory.NOT_RECURSIVE ? ProofKind.NON_RECURSIVE : ProofKind.RECURSIVE;\n944\t    }\n945\t\n946\t    private static Bytes hashOf(@NonNull final HistoryProof proof) {\n947\t        return noThrowSha384HashOf(HistoryProof.PROTOBUF.toBytes(proof));\n948\t    }\n949\t}\n950\t"}]},"parent_tool_use_id":null,"session_id":"0b68b30f-133f-4078-a9a7-ee7aeeec8953","uuid":"8ca093ad-7eab-4f99-bfbe-4cf35782c9ae","timestamp":"2026-09-02T08:26:38.366Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/hcn/WrapsHistoryProver.java","content":"// SPDX-License-Identifier: Apache-2.0\npackage com.hedera.node.app.history.impl;\n\nimport static com.hedera.hapi.node.state.history.WrapsPhase.AGGREGATE;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.POST_AGGREGATION;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.R1;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.R2;\nimport static com.hedera.hapi.node.state.history.WrapsPhase.R3;\nimport static com.hedera.hapi.util.HapiUtils.asInstant;\nimport static com.hedera.node.app.hapi.utils.CommonUtils.noThrowSha384HashOf;\nimport static com.hedera.node.app.history.HistoryLibrary.MISSING_SCHNORR_KEY;\nimport static com.hedera.node.app.history.impl.WrapsMpcStateMachine.POST_MPC_PHASES;\nimport static java.util.Collections.emptySortedMap;\nimport static java.util.Objects.requireNonNull;\nimport static java.util.concurrent.TimeUnit.MILLISECONDS;\n\nimport com.hedera.hapi.node.state.history.AggregatedNodeSignatures;\nimport com.hedera.hapi.node.state.history.ChainOfTrustProof;\nimport com.hedera.hapi.node.state.history.History;\nimport com.hedera.hapi.node.state.history.HistoryProof;\nimport com.hedera.hapi.node.state.history.HistoryProofConstruction;\nimport com.hedera.hapi.node.state.history.HistoryProofVote;\nimport com.hedera.hapi.node.state.history.WrapsPhase;\nimport com.hedera.hapi.node.state.history.WrapsSigningState;\nimport com.hedera.node.app.history.HistoryLibrary;\nimport com.hedera.node.app.history.HistoryLibrary.AddressBook;\nimport com.hedera.node.app.history.ReadableHistoryStore.WrapsMessagePublication;\nimport com.hedera.node.app.history.WritableHistoryStore;\nimport com.hedera.node.app.history.impl.ProofKeysAccessorImpl.SchnorrKeyPair;\nimport com.hedera.node.app.service.roster.impl.RosterTransitionWeights;\nimport com.hedera.node.config.data.TssConfig;\nimport com.hedera.pbj.runtime.io.buffer.Bytes;\nimport edu.umd.cs.findbugs.annotations.NonNull;\nimport edu.umd.cs.findbugs.annotations.Nullable;\nimport java.security.SecureRandom;\nimport java.time.Duration;\nimport java.time.Instant;\nimport java.util.ArrayList;\nimport java.util.EnumMap;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.SortedMap;\nimport java.util.TreeSet;\nimport java.util.concurrent.CompletableFuture;\nimport java.util.concurrent.Executor;\nimport java.util.concurrent.TimeUnit;\nimport java.util.function.Consumer;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\n\n/**\n * A {@link HistoryProver} that uses the WRAPS protocol to construct a {@link HistoryProof} that uses a\n * {@link ChainOfTrustProof#wrapsProof()} to establish chain of trust from the genesis address book hash.\n * The state machine moves first through a signing protocol that forms an aggregate signature from three\n * rounds of exchanging WRAPS messages; and then runs a heavy compression step to form a succinct proof.\n */\npublic class WrapsHistoryProver implements HistoryProver {\n    private static final Logger log = LogManager.getLogger(WrapsHistoryProver.class);\n    public static final String MISSING_MESSAGES_FAILURE_PREFIX = \"Still missing messages from R1 nodes \";\n    public static final String WRAPS_NOT_READY_FAILURE_PREFIX = \"WRAPS library is not ready\";\n    public static final String LEDGER_ID_NOT_READY_FAILURE_PREFIX = \"Ledger id is not yet available\";\n\n    private final long selfId;\n    private final Duration wrapsMessageGracePeriod;\n    private final SchnorrKeyPair schnorrKeyPair;\n    private final Map<Long, Bytes> proofKeys;\n    private final RosterTransitionWeights weights;\n    private final Delayer delayer;\n    private final Executor executor;\n\n    @Nullable\n    private final HistoryProof sourceProof;\n\n    private final HistoryLibrary historyLibrary;\n    private final HistorySubmissions submissions;\n    private final WrapsMpcStateMachine machine;\n    private final Object voteLock = new Object();\n\n    private final Map<WrapsPhase, SortedMap<Long, WrapsMessagePublication>> phaseMessages =\n            new EnumMap<>(WrapsPhase.class);\n    private final Map<Long, Bytes> explicitHistoryProofHashes = new HashMap<>();\n\n    /**\n     * If non-null, the phase whose last publish returned a WRAPS-not-ready noop;\n     * cleared at the next publishIfNeeded so the publish is retried.\n     */\n    @Nullable\n    private volatile WrapsPhase phaseNeedingWrapsReadinessRetry;\n\n    /**\n     * If not null, the WRAPS message being signed for the current construction.\n     */\n    @Nullable\n    private byte[] wrapsMessage;\n\n    /**\n     * If not null, the target address book being added to the chain of trust.\n     */\n    @Nullable\n    private AddressBook targetAddressBook;\n\n    /**\n     * If not null, the hash of the target address book.\n     */\n    @Nullable\n    private byte[] targetAddressBookHash;\n\n    /**\n     * If non-null, the entropy used to generate the R1 message. (If this node rejoins the network\n     * after a restart, having lost its entropy, it cannot continue and the protocol will time out.)\n     */\n    @Nullable\n    private byte[] entropy;\n\n    /**\n     * Future that resolves on submission of this node's R1 signing message.\n     */\n    @Nullable\n    private CompletableFuture<Void> r1Future;\n\n    /**\n     * Future that resolves on submission of this node's R2 signing message.\n     */\n    @Nullable\n    private CompletableFuture<Void> r2Future;\n\n    /**\n     * Future that resolves on submission of this node's R3 signing message.\n     */\n    @Nullable\n    private CompletableFuture<Void> r3Future;\n\n    /**\n     * If non-null, the history proof we have constructed (recursive or otherwise).\n     */\n    @Nullable\n    private HistoryProof historyProof;\n\n    /**\n     * Future that resolves on the completion of the proof vote decision post-jitter.\n     */\n    @Nullable\n    private CompletableFuture<VoteDecision> voteDecisionFuture;\n\n    /**\n     * Future that resolves on submission of this node's vote for proof.\n     */\n    @Nullable\n    private volatile CompletableFuture<Void> voteFuture;\n\n    /**\n     * The kind of proof work associated with {@link #voteFuture}; this is set while either computing or voting on it.\n     */\n    @Nullable\n    private ProofKind voteFutureKind;\n\n    /**\n     * If non-null, a node whose explicit recursive proof has already been validated.\n     */\n    @Nullable\n    private Long validRecursiveProofNodeId;\n\n    private boolean nonRecursiveProofFinalized;\n    private boolean recursiveProofFinalized;\n\n    /**\n     * The current WRAPS phase; starts with R1 and advances as messages are received.\n     */\n    private WrapsPhase wrapsPhase = R1;\n\n    /**\n     * Indicates this prover's construction has been canceled and any post-output work should be skipped.\n     */\n    private volatile boolean constructionCanceled = false;\n\n    private sealed interface WrapsPhaseOutput\n            permits NoopOutput, MessagePhaseOutput, ProofPhaseOutput, AggregatePhaseOutput {}\n\n    private record NoopOutput(String reason) implements WrapsPhaseOutput {}\n\n    private record MessagePhaseOutput(byte[] message) implements WrapsPhaseOutput {}\n\n    private record AggregatePhaseOutput(byte[] signature, List<Long> nodeIds) implements WrapsPhaseOutput {}\n\n    private record ProofPhaseOutput(byte[] compressed, byte[] uncompressed) implements WrapsPhaseOutput {\n        @NonNull\n        @Override\n        public String toString() {\n            return \"WRAPS{compressed=\"\n                    + compressed.length\n                    + \" bytes (\" + Bytes.wrap(noThrowSha384HashOf(compressed)) + \"), \" + \"uncompressed=\"\n                    + uncompressed.length\n                    + \" bytes (\" + Bytes.wrap(noThrowSha384HashOf(uncompressed)) + \")\"\n                    + \"}\";\n        }\n    }\n\n    private enum VoteChoice {\n        SUBMIT,\n        SKIP\n    }\n\n    private enum ProofKind {\n        NON_RECURSIVE,\n        RECURSIVE\n    }\n\n    private record VoteDecision(VoteChoice choice, @Nullable Long congruentNodeId) {\n        static VoteDecision explicit() {\n            return new VoteDecision(VoteChoice.SUBMIT, null);\n        }\n\n        static VoteDecision skip() {\n            return new VoteDecision(VoteChoice.SKIP, null);\n        }\n\n        static VoteDecision congruent(long nodeId) {\n            return new VoteDecision(VoteChoice.SUBMIT, nodeId);\n        }\n    }\n\n    public interface Delayer {\n        @NonNull\n        Executor delayedExecutor(long delay, @NonNull TimeUnit unit, @NonNull Executor executor);\n    }\n\n    public WrapsHistoryProver(\n            final long selfId,\n            @NonNull final Duration wrapsMessageGracePeriod,\n            @NonNull final SchnorrKeyPair schnorrKeyPair,\n            @Nullable final HistoryProof sourceProof,\n            @NonNull final RosterTransitionWeights weights,\n            @NonNull final Map<Long, Bytes> proofKeys,\n            @NonNull final Delayer delayer,\n            @NonNull final Executor executor,\n            @NonNull final HistoryLibrary historyLibrary,\n            @NonNull final HistorySubmissions submissions,\n            @NonNull final WrapsMpcStateMachine machine) {\n        this.selfId = selfId;\n        this.sourceProof = sourceProof;\n        this.wrapsMessageGracePeriod = requireNonNull(wrapsMessageGracePeriod);\n        this.schnorrKeyPair = requireNonNull(schnorrKeyPair);\n        this.weights = requireNonNull(weights);\n        this.proofKeys = requireNonNull(proofKeys);\n        this.delayer = requireNonNull(delayer);\n        this.executor = requireNonNull(executor);\n        this.historyLibrary = requireNonNull(historyLibrary);\n        this.submissions = requireNonNull(submissions);\n        this.machine = requireNonNull(machine);\n    }\n\n    @NonNull\n    @Override\n    public Outcome advance(\n            @NonNull final Instant now,\n            @NonNull final HistoryProofConstruction construction,\n            @NonNull final Bytes targetMetadata,\n            @NonNull final Map<Long, Bytes> targetProofKeys,\n            @NonNull final TssConfig tssConfig,\n            @Nullable final Bytes ledgerId,\n            final boolean canSubmit) {\n        requireNonNull(now);\n        requireNonNull(construction);\n        requireNonNull(targetMetadata);\n        requireNonNull(targetProofKeys);\n        requireNonNull(tssConfig);\n        if (ledgerId == null && sourceProof != null) {\n            return new Outcome.Failed(\"Only genesis WRAPS proofs are allowed to not have a ledger id\");\n        }\n        final var state = construction.wrapsSigningStateOrElse(WrapsSigningState.DEFAULT);\n        if (state.phase() != AGGREGATE\n                && state.hasGracePeriodEndTime()\n                && now.isAfter(asInstant(state.gracePeriodEndTimeOrThrow()))) {\n            final var submittingNodes =\n                    phaseMessages.getOrDefault(state.phase(), emptySortedMap()).keySet();\n            // If we reached a stage with a grace period, we must have at least one R1 message, so no getOrDefault()\n            final var missingNodes = phaseMessages.get(R1).keySet().stream()\n                    .filter(nodeId -> !submittingNodes.contains(nodeId))\n                    .toList();\n            return new Outcome.Failed(MISSING_MESSAGES_FAILURE_PREFIX + missingNodes\n                    + \" after end of grace period for phase \" + state.phase());\n        } else {\n            if (!canSubmit) {\n                return Outcome.InProgress.INSTANCE;\n            }\n            if (wrapsMessage == null) {\n                // Avoid caching a partial derived state if one of these computations throws.\n                final var computedTargetAddressBook =\n                        AddressBook.from(weights.targetNodeWeights(), nodeId -> targetProofKeys\n                                .getOrDefault(nodeId, MISSING_SCHNORR_KEY)\n                                .toByteArray());\n                final var computedWrapsMessage =\n                        historyLibrary.computeWrapsMessage(computedTargetAddressBook, targetMetadata.toByteArray());\n                final var computedTargetAddressBookHash = historyLibrary.hashAddressBook(computedTargetAddressBook);\n                targetAddressBook = computedTargetAddressBook;\n                wrapsMessage = computedWrapsMessage;\n                targetAddressBookHash = computedTargetAddressBookHash;\n            }\n            final var effectivePhase = construction.hasTargetProof() ? POST_AGGREGATION : state.phase();\n            publishIfNeeded(\n                    construction.constructionId(),\n                    effectivePhase,\n                    targetMetadata,\n                    targetProofKeys,\n                    tssConfig,\n                    ledgerId,\n                    construction.targetProof());\n        }\n        return Outcome.InProgress.INSTANCE;\n    }\n\n    public static boolean isRecoverableFailure(@NonNull final String reason) {\n        requireNonNull(reason);\n        return reason.startsWith(MISSING_MESSAGES_FAILURE_PREFIX);\n    }\n\n    @Override\n    public boolean addWrapsSigningMessage(\n            final long constructionId,\n            @NonNull final WrapsMessagePublication publication,\n            @NonNull final WritableHistoryStore writableHistoryStore) {\n        requireNonNull(publication);\n        requireNonNull(writableHistoryStore);\n        return receiveWrapsSigningMessage(constructionId, publication, writableHistoryStore);\n    }\n\n    @Override\n    public void replayWrapsSigningMessage(long constructionId, @NonNull WrapsMessagePublication publication) {\n        receiveWrapsSigningMessage(constructionId, publication, null);\n    }\n\n    @Override\n    public void observeProofVote(\n            final long nodeId,\n            @NonNull final HistoryProofVote vote,\n            final boolean proofFinalized,\n            @NonNull final ProofVoteCategory proofVoteCategory) {\n        requireNonNull(vote);\n        requireNonNull(proofVoteCategory);\n        if (proofFinalized) {\n            log.info(\"Observed finalized proof via node{}; skipping vote\", nodeId);\n            final var proofKind = proofKindOf(proofVoteCategory);\n            final CompletableFuture<VoteDecision> decisionFuture;\n            synchronized (voteLock) {\n                markFinalized(proofKind);\n                decisionFuture = voteFutureKind == null || voteFutureKind == proofKind ? voteDecisionFuture : null;\n                if (decisionFuture != null) {\n                    voteDecisionFuture = null;\n                }\n                if (voteFutureKind == proofKind) {\n                    voteFuture = null;\n                    voteFutureKind = null;\n                }\n            }\n            if (decisionFuture != null) {\n                decisionFuture.complete(VoteDecision.skip());\n            }\n            return;\n        }\n        // Explicit vote case\n        if (vote.hasProof()) {\n            final var proof = vote.p