+{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014zhTbH2R8Fj1UCa88NAsAV","type":"tool_result","content":"1\t// SPDX-License-Identifier: Apache-2.0\n2\tpackage com.hedera.node.app.service.roster.impl;\n3\t\n4\timport static java.util.Objects.requireNonNull;\n5\t\n6\timport edu.umd.cs.findbugs.annotations.NonNull;\n7\timport java.math.BigInteger;\n8\timport java.util.Comparator;\n9\timport java.util.Map;\n10\timport java.util.Set;\n11\timport java.util.SortedMap;\n12\timport java.util.SortedSet;\n13\timport java.util.TreeSet;\n14\timport java.util.stream.Stream;\n15\t\n16\t/**\n17\t * Represents the weights of the nodes in a roster transition.\n18\t * @param sourceNodeWeights the weights of the nodes in the source roster\n19\t * @param targetNodeWeights the weights of the nodes in the target roster\n20\t * @param sourceWeightThreshold the weight required for at least 1/3 weight in the source roster\n21\t * @param targetWeightThreshold the weight required for strictly more than 2/3 weight in the target roster\n22\t */\n23\tpublic record RosterTransitionWeights(\n24\t        @NonNull SortedMap<Long, Long> sourceNodeWeights,\n25\t        @NonNull SortedMap<Long, Long> targetNodeWeights,\n26\t        long sourceWeightThreshold,\n27\t        long targetWeightThreshold) {\n28\t\n29\t    public RosterTransitionWeights(\n30\t            @NonNull final SortedMap<Long, Long> sourceNodeWeights,\n31\t            @NonNull final SortedMap<Long, Long> targetNodeWeights) {\n32\t        this(\n33\t                requireNonNull(sourceNodeWeights),\n34\t                requireNonNull(targetNodeWeights),\n35\t                atLeastOneThirdOfTotal(sourceNodeWeights),\n36\t                moreThanTwoThirdsOfTotal(targetNodeWeights));\n37\t    }\n38\t\n39\t    /**\n40\t     * Represents the weight of a node in a roster.\n41\t     * @param nodeId the ID of the node\n42\t     * @param weight the weight of the node\n43\t     */\n44\t    public record NodeWeight(long nodeId, long weight) implements Comparable<NodeWeight> {\n45\t        private static final Comparator<NodeWeight> NODE_ID_COMPARATOR = Comparator.comparingLong(NodeWeight::nodeId);\n46\t\n47\t        @Override\n48\t        public int compareTo(@NonNull final NodeWeight that) {\n49\t            return NODE_ID_COMPARATOR.compare(this, that);\n50\t        }\n51\t    }\n52\t\n53\t    /**\n54\t     * Returns the source node ids in the target roster.\n55\t     * @return the source node ids in the target roster\n56\t     */\n57\t    public SortedSet<Long> sourceNodeIds() {\n58\t        return new TreeSet<>(sourceNodeWeights.keySet());\n59\t    }\n60\t\n61\t    /**\n62\t     * Returns the target node ids in the source roster.\n63\t     * @return the target node ids in the source roster\n64\t     */\n65\t    public Set<Long> targetNodeIds() {\n66\t        return targetNodeWeights.keySet();\n67\t    }\n68\t\n69\t    /**\n70\t     * Returns whether the source roster has a strict majority of weight in the target roster.\n71\t     */\n72\t    public boolean sourceNodesHaveTargetThreshold() {\n73\t        return sourceNodeWeights.keySet().stream()\n74\t                        .filter(targetNodeWeights::containsKey)\n75\t                        .mapToLong(targetNodeWeights::get)\n76\t                        .sum()\n77\t                >= targetWeightThreshold;\n78\t    }\n79\t\n80\t    /**\n81\t     * Returns the weights of the nodes in the source roster in ascending order of node ID.\n82\t     * @return the weights of the nodes in the source roster\n83\t     */\n84\t    public Stream<NodeWeight> orderedSourceWeights() {\n85\t        return sourceNodeWeights.entrySet().stream()\n86\t                .map(entry -> new NodeWeight(entry.getKey(), entry.getValue()))\n87\t                .sorted();\n88\t    }\n89\t\n90\t    /**\n91\t     * Returns the weights of the nodes in the source roster in ascending order of node ID.\n92\t     * @return the weights of the nodes in the source roster\n93\t     */\n94\t    public Stream<NodeWeight> orderedTargetWeights() {\n95\t        return targetNodeWeights.entrySet().stream()\n96\t                .map(entry -> new NodeWeight(entry.getKey(), entry.getValue()))\n97\t                .sorted();\n98\t    }\n99\t\n100\t    /**\n101\t     * Returns the weight of a node in the source roster.\n102\t     * @param nodeId the ID of the node\n103\t     * @return the weight of the node\n104\t     */\n105\t    public long sourceWeightOf(final long nodeId) {\n106\t        return sourceNodeWeights.getOrDefault(nodeId, 0L);\n107\t    }\n108\t\n109\t    /**\n110\t     * Returns the total weight of the source roster.\n111\t     */\n112\t    public long totalSourceWeight() {\n113\t        return sourceNodeWeights.values().stream().mapToLong(Long::longValue).sum();\n114\t    }\n115\t\n116\t    /**\n117\t     * Returns whether given node has an explicit weight in the target roster.\n118\t     * @param nodeId the ID of the node\n119\t     * @return whether the node has an explicit weight\n120\t     */\n121\t    public boolean targetIncludes(final long nodeId) {\n122\t        return targetNodeWeights.containsKey(nodeId);\n123\t    }\n124\t\n125\t    /**\n126\t     * Returns the weight of a node in the target roster.\n127\t     * @param nodeId the ID of the node\n128\t     * @return the weight of the node\n129\t     */\n130\t    public long targetWeightOf(final long nodeId) {\n131\t        return targetNodeWeights.getOrDefault(nodeId, 0L);\n132\t    }\n133\t\n134\t    /**\n135\t     * Returns the size of the target roster.\n136\t     */\n137\t    public int targetRosterSize() {\n138\t        return targetNodeWeights.size();\n139\t    }\n140\t\n141\t    /**\n142\t     * Returns the number of target node ids in the source roster.\n143\t     * @return the number of target node ids in the source roster\n144\t     */\n145\t    public int numTargetNodesInSource() {\n146\t        return numTargetNodesIn(sourceNodeWeights.keySet());\n147\t    }\n148\t\n149\t    /**\n150\t     * Returns the number of target node ids in a given set of node ids.\n151\t     * @param nodeIds the set of node ids\n152\t     * @return the number of target node ids in the set\n153\t     */\n154\t    public int numTargetNodesIn(@NonNull final Set<Long> nodeIds) {\n155\t        return targetNodeWeights.keySet().stream()\n156\t                .filter(nodeIds::contains)\n157\t                .mapToInt(i -> 1)\n158\t                .sum();\n159\t    }\n160\t\n161\t    /**\n162\t     * Returns the weight that would constitute a strong minority of the network weight for a roster.\n163\t     *\n164\t     * @param weights the weights of the nodes in the roster\n165\t     * @return the weight required for a strong minority\n166\t     */\n167\t    public static long atLeastOneThirdOfTotal(@NonNull final Map<Long, Long> weights) {\n168\t        requireNonNull(weights);\n169\t        return atLeastOneThirdOfTotal(\n170\t                weights.values().stream().mapToLong(Long::longValue).sum());\n171\t    }\n172\t\n173\t    /**\n174\t     * Returns a weight that, assuming no corruption beyond the Byzantine threshold, guarantees agreement\n175\t     * from an honest node holding at non-zero weight.\n176\t     * @param totalWeight the total weight of the network\n177\t     * @return the weight required to guarantee agreement with an honest node holding non-zero weight\n178\t     */\n179\t    public static long atLeastOneThirdOfTotal(final long totalWeight) {\n180\t        // Since aBFT is unachievable with n/3 malicious weight, using the conclusion of n/3 weight\n181\t        // ensures it the conclusion overlaps with the weight held by at least one honest node\n182\t        return (totalWeight + 2) / 3;\n183\t    }\n184\t\n185\t    /**\n186\t     * Returns the weight that, assuming no corruption beyond the Byzantine threshold, guarantees sufficient\n187\t     * honest nodes to reach agreement backed by at least 1/3 of the total network we