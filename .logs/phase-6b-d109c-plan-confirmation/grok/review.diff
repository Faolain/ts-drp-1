  99\t\tprivate closed = false;\n   100\t\tprivate poisoned = false;\n   101\t\n   102\t\t/**\n   103\t\t *\n   104\t\t * @param durability - Input value.\n   105\t\t */\n   106\t\tpublic constructor(private readonly durability: TransitionDurability) {}\n   107\t\n   108\t\tprivate lifecycleFailure(): StoreResult<never> | undefined {\n   109\t\t\tif (this.closed) return rejected(\"STORE_CLOSED\");\n   110\t\t\tif (this.poisoned) return rejected(\"STORE_POISONED\");\n   111\t\t\treturn undefined;\n   112\t\t}\n   113\t\n   114\t\tprivate latchIntegrityFailure<T>(reason: Exclude<StorageRejectionReason, \"SUBSTRATE_FAILURE\">): StoreResult<T> {\n   115\t\t\tthis.poisoned = true;\n   116\t\t\treturn rejected(reason);\n   117\t\t}\n   118\t\n   119\t\t/**\n   120\t\t * Reads one detached head+journal snapshot.\n   121\t\t * @param objectId - Input value.\n   122\t\t * @returns A detached state or stable rejection.\n   123\t\t */\n   124\t\tpublic readObjectState(objectId: StorageObjectId): StoreResult<TransitionObjectState> {\n   125\t\t\tif (!isStorageObjectId(objectId)) return rejected(\"INVALID_ARGUMENT\");\n   126\t\t\tconst lifecycleFailure = this.lifecycleFailure();\n   127\t\t\tif (lifecycleFailure !== undefined) return lifecycleFailure;\n   128\t\t\tconst object = this.objects.get(objectId);\n   129\t\t\tif (object === undefined) {\n   130\t\t\t\treturn { ok: true, value: { head: { kind: \"none\", objectId }, generations: [] } };\n   131\t\t\t}\n   132\t\t\treturn {\n   133\t\t\t\tok: true,\n   134\t\t\t\tvalue: {\n   135\t\t\t\t\thead: cloneHead(object.head),\n   136\t\t\t\t\tgenerations: object.generationIds.map((generationId) => indexedGenerationRecord(object, generationId)),\n   137\t\t\t\t},\n   138\t\t\t};\n   139\t\t}\n   140\t\n   141\t\t/**\n   142\t\t * Reads one detached head without materializing the object's journal.\n   143\t\t * @param objectId - Canonical object identity.\n   144\t\t * @returns The detached head or stable rejection.\n   145\t\t */\n   146\t\tpublic readHead(objectId: StorageObjectId): StoreResult<ExpectedHead> {\n   147\t\t\tif (!isStorageObjectId(objectId)) return rejected(\"INVALID_ARGUMENT\");\n   148\t\t\tconst lifecycleFailure = this.lifecycleFailure();\n   149\t\t\tif (lifecycleFailure !== undefined) return lifecycleFailure;\n   150\t\t\tconst object = this.objects.get(objectId);\n   151\t\t\treturn {\n   152\t\t\t\tok: true,\n   153\t\t\t\tvalue: object === undefined ? { kind: \"none\", objectId } : cloneHead(object.head),\n   154\t\t\t};\n   155\t\t}\n   156\t\n   157\t\t/**\n   158\t\t * Reads at most one internally bounded, detached generation page in canonical ID order.\n   159\t\t * @param objectId - Canonical object identity.\n   160\t\t * @param afterGenerationId - Exclusive canonical lower bound, or the beginning.\n   161\t\t * @param limit - Maximum number of records to detach.\n   162\t\t * @returns The detached page or stable rejection.\n   163\t\t */\n   164\t\tpublic readGenerationPage(\n   165\t\t\tobjectId: StorageObjectId,\n   166\t\t\tafterGenerationId: GenerationId | null,\n   167\t\t\tlimit: number\n   168\t\t): StoreResult<readonly GenerationRecord[]> {\n   169\t\t\tif (\n   170\t\t\t\t!isStorageObjectId(objectId) ||\n   171\t\t\t\t(afterGenerationId !== null && !isGenerationId(afterGenerationId)) ||\n   172\t\t\t\t!Number.isSafeInteger(limit) ||\n   173\t\t\t\tlimit < 1 ||\n   174\t\t\t\tlimit > MAX_INTERNAL_GENERATION_PAGE_ROWS\n   175\t\t\t) {\n   176\t\t\t\treturn rejected(\"INVALID_ARGUMENT\");\n   177\t\t\t}\n   178\t\t\tconst lifecycleFailure = this.lifecycleFailure();\n   179\t\t\tif (lifecycleFailure !== undefined) return lifecycleFailure;\n   180\t\t\tconst object = this.objects.get(objectId);\n   181\t\t\tif (object === undefined) return { ok: true, value: [] };\n   182\t\t\tconst start = firstGenerationAfter(object.generationIds, afterGenerationId);\n   183\t\t\tconst end = Math.min(start + limit, object.generationIds.length);\n   184\t\t\tconst generat