undefined ? null : new Uint8Array(value) };\n   221\t\t}\n   222\t\n   223\t\t/**\n   224\t\t * Captures a new immutable Staged generation.\n   225\t\t * @param input - Input value.\n   226\t\t * @param input.objectId - Input value.\n   227\t\t * @param input.generationId - Input value.\n   228\t\t * @param input.baseExpectedHead - Input value.\n   229\t\t * @param input.closure - Input value.\n   230\t\t * @returns The staged record or stable rejection.\n   231\t\t */\n   232\t\tpublic beginGeneration(input: {\n   233\t\t\tobjectId: StorageObjectId;\n   234\t\t\tgenerationId: GenerationId;\n   235\t\t\tbaseExpectedHead: ExpectedHead;\n   236\t\t\tclosure: readonly GenerationRef[];\n   237\t\t}): StoreResult<GenerationRecord> {\n   238\t\t\tif (!isClosedRecord(input, [\"objectId\", \"generationId\", \"baseExpectedHead\", \"closure\"])) {\n   239\t\t\t\treturn rejected(\"INVALID_ARGUMENT\");\n   240\t\t\t}\n   241\t\t\tif (!isStorageObjectId(input.objectId) || !isGenerationId(input.generationId)) {\n   242\t\t\t\treturn rejected(\"INVALID_ARGUMENT\");\n   243\t\t\t}\n   244\t\t\tconst baseExpectedHead = copyExpectedHead(input.baseExpectedHead, input.objectId);\n   245\t\t\tif (baseExpectedHead === undefined || !isClosedArray(input.closure)) return rejected(\"INVALID_ARGUMENT\");\n   246\t\t\tconst closure: GenerationRef[] = [];\n   247\t\t\tfor (const value of input.closure) {\n   248\t\t\t\tconst copied = copyGenerationRef(value);\n   249\t\t\t\tif (copied === undefined) return rejected(\"INVALID_ARGUMENT\");\n   250\t\t\t\tclosure.push(copied);\n   251\t\t\t}\n   252\t\t\tconst lifecycleFailure = this.lifecycleFailure();\n   253\t\t\tif (lifecycleFailure !== undefined) return lifecycleFailure;\n   254\t\t\tconst existingObject = this.objects.get(input.objectId);\n   255\t\t\tif (existingObject?.generations.has(input.generationId) === true) return rejected(\"GENERATION_EXISTS\");\n   256\t\t\tconst currentHead = existingObject?.head ?? { kind: \"none\" as const, obj