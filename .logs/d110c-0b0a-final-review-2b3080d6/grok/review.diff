+	return publishOwner === undefined
+		? Promise.resolve(
+				Object.freeze({
+					detail: "creator adoption publish owner is unavailable",
+					kind: "internal-invariant",
+					ok: false,
+				})
+			)
+		: publishOwner(input);
+}
