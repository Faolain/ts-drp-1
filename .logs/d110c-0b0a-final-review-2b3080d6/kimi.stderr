+async function verifiedIntent(fixture: GenuineCreatorAdoptionFixture): Promise<unknown> {
+	const verified = await fixture.modules.verifyCreatorSuccessorAdoption({
+		catalog: fixture.catalog,
+		handle: fixture.handle,
