	readonly pinnedGenesisAnchorDigest: string;
}

type GenesisAnchorSigner = (digest: Uint8Array) => Promise<Uint8Array>;

export interface V3RoomCreatorInviteMaterialInput {
	readonly blueprintDigest: string;
