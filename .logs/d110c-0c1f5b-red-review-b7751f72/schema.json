{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "p0_count",
    "p1_count",
    "p2_count",
    "findings",
    "causal_red_assessment",
    "coverage_assessment",
    "realm_assessment",
    "golden_path_assessment",
    "scope_api_assessment",
    "evidence_assessment",
    "green_ready"
  ],
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_VERDICT"] },
    "p0_count": { "type": "integer", "minimum": 0 },
    "p1_count": { "type": "integer", "minimum": 0 },
    "p2_count": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "evidence", "impact", "required_action"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "impact": { "type": "string" },
          "required_action": { "type": "string" }
        }
      }
    },
    "causal_red_assessment": { "type": "string" },
    "coverage_assessment": { "type": "string" },
    "realm_assessment": { "type": "string" },
    "golden_path_assessment": { "type": "string" },
    "scope_api_assessment": { "type": "string" },
    "evidence_assessment": { "type": "string" },
    "green_ready": { "type": "boolean" }
  }
}
