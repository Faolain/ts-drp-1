+				...input.plan,
+				entries: Object.freeze(input.plan.entries.map((entry) => Object.freeze({ ...entry }))),
+				revision: (settlementPlan?.revision ?? -1) + 1,
+				scope,
+			});
+			return Promise.resolve(settlementPlan);
+		}),
+	});
