	});

	it.skipIf(!state.ready)("owns six genuine SIGKILL edges with old XOR complete-new reopen state", async () => {
		expect(D109C_CRASH_EDGES).toEqual([
			"after-floor-rewrite",
			"after-promotion-delete",
			"after-generation-delete",
			"after-blob-delete",
			"before-commit",
			"after-commit",
