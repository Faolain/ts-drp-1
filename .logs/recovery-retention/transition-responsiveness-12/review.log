			const nodes: ts.VariableDeclaration[] = []; const visit = (node: ts.Node): void => {
				if (ts.isVariableDeclaration(node) && ts.isIdentifier(node.name) && node.name.text === name) nodes.push(node);
				ts.forEachChild(node, visit);
