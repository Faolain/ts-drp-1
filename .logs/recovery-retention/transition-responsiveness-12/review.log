class HeldReadView {
	readonly transaction: IDBTransaction;
	readonly ready: Promise<void>;
	readonly #terminal: Promise<void>;
	readonly #store: IDBObjectStore;
	#running = true;
	#released = false;
	#ended = false;
	#intentionalAbort = false;
	#failure: unknown;
	#failed = false;
	#release?: Promise<void>;
	#inTurn = false;
	#futureCheck?: Promise<void>;
	readonly #queued: Array<{start: () => void; reject: (cause: unknown) => void}> = [];
	readonly #operations = new Set<Promise<unknown>>();

	constructor(database: IDBDatabase) {
		// All of this owner's stores: native foreign READWRITE transactions on them
		// cannot overlap this view. No schema/control/row is changed, and no
		// JavaScript lock grants it. On a room connection the owner's stores are
		// its own namespace only, so the view never blocks another owner (14a).
		const stores = roomOwnerStoreNames(database);
		if (stores.length === 0) throw new Error("NATIVE_READ_RESERVATION_EMPTY_SCHEMA");
		this.transaction = database.transaction(stores, "readonly");
		this.#store = this.transaction.objectStore(this.transaction.objectStoreNames[0]!);
		views.set(this.transaction, this);
		this.#terminal = new Promise<void>((resolve, reject) => {
			this.transaction.addEventListener("complete", () => {
				this.#ended = true;
				this.#rejectQueued(this.#failed ? this.#failure : new Error("NATIVE_READ_RESERVATION_RELEASED"));
				if (this.#failed) reject(this.#failure); else resolve();
			}, { once: true });
			this.transaction.addEventListener("abort", () => {
				this.#ended = true;
				this.#rejectQueued(this.#failed ? this.#failure : this.transaction.error ?? new Error("NATIVE_READ_RESERVATION_ABORTED"));
				if (this.#intentionalAbort && !this.#failed) resolve();
				else reject(this.#failed ? this.#failure : this.transaction.error ?? new Error("NATIVE_READ_RESERVATION_ABORTED"));
			}, { once: true });
			this.transaction.addEventListener("error", (event) => {
				// Native abort reports AbortError on each pending request. An
				// intentional owner close owns that cancellation, not a substrate
				// failure; other request errors remain the original failure.
				if (this.#intentionalAbort && event.target instanceof IDBRequest && event.target.error?.name === "AbortError") return;
				this.#failed = true;
				this.#failure = this.transaction.error ?? new Error("NATIVE_READ_RESERVATION_FAILED");
				this.#rejectQueued(this.#failure);
			});
		});
		// Acquisition/operation callers and release still own the original error.
		void this.#terminal.catch(() => undefined);
		this.ready = new Promise<void>((resolve, reject) => this.#pump(resolve, reject));
	}

	#pump(resolve?: () => void, reject?: (cause: unknown) => void): void {
		try {
			const request = this.#store.getKey("");
			request.addEventListener("success", () => {
				this.#inTurn = true;
				try { for (const job of this.#queued.splice(0)) job.start(); }
				finally { this.#inTurn = false; }
				// Real work admitted on this native turn queues its requests first.
				// Put the next sentinel behind those requests, not in front of them:
				// otherwise each real read also services a needless sentinel before
				// its result can arrive. This is still synchronous in the original
				// active native handler; no timer or Promise stands in for exclusion.
				if (this.#running) this.#pump();
				resolve?.();
			}, { once: true });
			request.addEventListener("error", () => {
				if (this.#intentionalAbort && request.error?.name === "AbortError") {
					reject?.(new Error("NATIVE_READ_RESERVATION_RELEASED"));
					return;
				}
				this.#failed = true;
				this.#failure = request.error ?? new Error("NATIVE_READ_RESERVATION_FAILED");
				reject?.(this.#failure);
			}, { once: true });
		} catch (cause) {
			this.#failed = true;
			this.#failure = cause;
			reject?.(cause);
			this.#running = false;
			this.#rejectQueued(cause);
		}
	}

	#rejectQueued(cause: unknown): void {
		for (const job of this.#queued.splice(0)) job.reject(cause);
	) {
		return localIssueFailure("not-active", "v3 plane is not accepting local issues");
	}
	const first = input.operations[0];
	if (first === undefined) return localIssueFailure("malformed-input", "v3 local issue operations are invalid");
	if (registration.operationAdmissionHalted)
		return localIssueFailure("admission-rejected", "v3 operation admission is halted until recovery");
	const readinessFailure = await localSnapshotAdmissionFailure(registration);
	if (readinessFailure !== undefined) return readinessFailure;
	if (registration.blueprintClosing || registration.terminalState !== "active" || registration.retainedBootstrapHold)
		return localIssueFailure("not-active", "v3 plane is not accepting local issues");
	if (isAuthorFenceOperation(first.operation)) return issueAuthorFence(registration, input);
	// Plain local work has no historical source/effect binding. Use the existing
	// NEW-operation owner before frontier joins can sign or mutate native state;
	// settlement-profile membership alone does not grant current Writer rights.
	// A halted native debt retains the original issuer's admission-rejected
	// outcome; the public preflight's not-active result is not its substitute.
	if (input.planEffect === undefined && !registration.operationAdmissionHalted) {
		for (const { operation } of input.operations) {
			const authorized = authorizeV3NewLocalOperation({ plane: registration.handle, operation });
			if (!authorized.ok) return authorized;
		}
	}
	if (
		input.planEffect !== undefined &&
		(input.planEffect.kind !== "replacement" || isReservedBatchAction(String(Reflect.get(first.operation, "action"))))
	) {
		return localIssueFailure("malformed-input", "v3 local issue plan effect is invalid");
	}
	if (input.planEffect?.kind === "replacement" && input.settlementSource === undefined) {
		return localIssueFailure(
			"authorization-rejected",
			"v3 settlement replacement requires its owning authenticated source"
		);
	}
	if (input.settlementSource !== undefined) {
		try {
			deriveOwnedReplacement(registration, input.settlementSource, input);
		} catch {
			return localIssueFailure("authorization-rejected", "v3 settlement replacement is not source authorized");
		}
	}
	if (input.planEffect?.kind === "replacement" && "fromIntent" in input.planEffect) {
		const effect = input.planEffect;
		let plan;
		try {
			plan = copySettlementPlan(
				await registration.issuanceStore.readSettlementPlan(registration.issuanceScope),
				registration.issuanceScope
			);
		} catch {
			registration.operationAdmissionHalted = true;
			return localIssueFailure("issuance-rejected", "v3 settlement replacement plan read failed");
		}
		const entry = plan?.entries.find((candidate) => candidate.sourceSequence === effect.sourceSequence);
		const progress = entry?.replacementProgress;
		if (
			progress === undefined ||
			entry?.replacementSequence !== null ||
			!sameBytes(progress.intentDigest, effect.intentDigest) ||
			(progress.chunks.at(-1)?.throughIntent ?? 0) !== effect.fromIntent ||
			effect.throughIntent > progress.intentCount
		) {
			return localIssueFailure("issuance-rejected", "v3 settlement replacement progress changed");
		}
	}
	// Authorize the requested work before frontier reduction can sign or journal
	// internal joins. Final per-vertex checks still run at their effect boundary.
	if (
		!isControlOperation(first.operation, registration.payload.trust.trust.profileId) &&
		!validateLatchedOperation(
			registration.authorization,
			registration.latchedOperations,
			aclOperation(registration.issuanceScope.author, "0".repeat(64), first.operation),
			registration.issuanceScope.author,
			registration.payload.trust.trust.profileId,
			false,
			input.settlementSource !== undefined && input.settlementAuthorization !== undefined
		)
	) {
		return localIssueFailure("authorization-rejected", "v3 local requested operation is not authorized");
	}
	let applicationOperation = first.operation;
	if (input.operations.length > 1) {
		if (typeof Reflect.get(registration.payload.runtime.reducers, APPLICATION_BATCH_ACTION) !== "function") {
			return localIssueFailure("malformed-input", "v3 local issue application batch reducer is unavailable");
		}
		const maximumPrefix = Math.min(input.operations.length, APPLICATION_BATCH_MAX_ENTRIES);
		let prefixLength = maximumPrefix;
		for (; prefixLength > 0; prefixLength -= 1) {
			const candidate = applicationBatchOperation(input.operations.slice(0, prefixLength));
			if (prefixLength === 1 || applicationBatchFits(candidate)) break;
		}
		if (prefixLength < input.operations.length) {
			return prefixLength > 0
				? localIssueSplit(prefixLength)
				: localIssueFailure("malformed-input", "v3 local issue operation exceeds the application batch budget");
		}
		applicationOperation = applicationBatchOperation(input.operations);
		if (!applicationBatchFits(applicationOperation)) {
			return localIssueFailure("malformed-input", "v3 local issue application batch is invalid");
		}
	}
	const initialTips = registration.index.tips();
	const maxDependencies = registration.payload.parameters.maxDependencies;
	if (initialTips.length === 0) return localIssueFailure("graph-rejected", "v3 local issue frontier is empty");
	if (maxDependencies < 2 && initialTips.length > maxDependencies) {
		return localIssueFailure("graph-rejected", "v3 local issue dependency bound cannot reduce the frontier");
	}
	const requiredJoins =
		initialTips.length <= maxDependencies
			? 0
			: Math.ceil((initialTips.length - maxDependencies) / (maxDependencies - 1));
	if (registration.index.size + requiredJoins + 1 > registration.payload.parameters.maxEpochVertices) {
		return localIssueFailure("graph-rejected", "v3 local issue graph is at capacity");
	}
	if (!hasGraphCapacity(registration, registration.issuanceScope.author, undefined, requiredJoins + 1)) {
		return localIssueFailure("graph-rejected", "v3 local issue author share is at capacity");
	}
	let finishingSuffix: CreatorOrdinaryIssuanceSuffixForSizing | undefined;
	if (requiredJoins !== 0 && registration.creatorMaintenanceBound && input.planEffect === undefined && input.settlementSource === undefined) {
		try {
			finishingSuffix = ObjectFreeze({additionalLocalVertices: requiredJoins + 1, graphVersion: registration.graphVersion,
				applicationOperationCount: input.operations.length,
				exactCanonicalApplicationOperationBytes: encodeCanonical(applicationOperation, APPLICATION_BATCH_LIMITS)});
		} catch {
			return localIssueFailure("admission-rejected", "requested suffix is outside prepared finishing capacity before any join");
		}
	}
	for (;;) {
		const tips = registration.index.tips();
		if (tips.length <= maxDependencies) {
			const issued = await issueOneVertex(
				registration,
				input,
				tips,
				first.logicalTime,
				applicationOperation,
				false,
				input.planEffect
			);
			if (issued.ok) await drainPendingIngress(registration);
			return issued;
		}
		const joined = await issueOneVertex(
			registration,
			input,
			tips.slice(0, maxDependencies),
			first.logicalTime,
			ObjectFreeze({ action: "causalJoin" }), false, undefined, finishingSuffix
		);
		if (!joined.ok) return joined;
		finishingSuffix = undefined;
	}
}

function enqueueLocalIssue(
	registration: V3PlaneRegistration,
	rawInput: V3LocalIssueInput
): Promise<V3LocalIssueResult> {
	if (registration.receiveOnly)
		return Promise.resolve(localIssueFailure("authorization-rejected", "v3 plane is receive-only"));
	if (!currentRegistration(registration))
		return Promise.resolve(localIssueFailure("not-active", "v3 plane is not accepting local issues"));
	const barrier = registration.terminalBarrier;
	return enqueueRegistrationTask(
		registration,
		(custody) => {
			const captured = capturedLocalIssueInput(registration.payload, rawInput, custody);
			return "ok" in captured
				? (): Promise<V3LocalIssueResult> => Promise.resolve(captured)
				: async (): Promise<V3LocalIssueResult> => {
						// Keep this admitted input charged and in its original FIFO while
						// timers run. issueLocal performs all current-owner/native checks.
						await yieldToHost();
						return issueLocal(registration, captured);
					};
		},
		{
			refuse: () =>
				localIssueFailure("admission-rejected", "v3 input task capacity exhausted; retry after admitted work joins"),
			refuseCapture: (capacity) =>
				localIssueFailure(
					"admission-rejected",
					`v3 input ${capacity} capacity exhausted; retry after admitted work joins`
				),
			...(barrier === undefined ? {} : { barrier }),
		}
	);
}

type ClassifiedRebaseRow = Readonly<{
	authenticated: AuthenticatedRecoveryVertex;
	kind: "covered-historical" | "current" | "displaced" | "pinned-genesis";
	row: SnapshottedOutboxRow;
}>;

const verifiedNestedNativeSources = new WeakSet<ClassifiedRebaseRow>();

/** Protected native completion, not a portable source-membership grant. */
async function ownSourceSettlementIsComplete(
	registration: V3PlaneRegistration,
	selected: ClassifiedRebaseRow,
	plan: SettlementPlan | null,
	vertexFacts?: CreatorCensusVertexFacts,
	sharedAccounting?: CreatorClosedRollbackProofAccounting
): Promise<boolean> {
	const source = selected.authenticated;
	const scope = registration.issuanceScope;
	if (!sameScope(selected.row.scope, scope) || source.author !== scope.author ||
