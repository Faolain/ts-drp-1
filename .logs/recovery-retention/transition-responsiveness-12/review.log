/** Optional exact-held native currency port; no observation or paid credit. */
function captureCreatorOrdinaryJournalCurrentProbe(read: LiveJournalRetirementImageReader,
	observation: LiveJournalRetirementImageObservation): LiveJournalRetirementImageCurrentProbe | undefined {
	// Only the original frozen producer's own data method can enroll the exact
	// returned observation. Bound/copied methods and caller image digests do not.
	if (!Object.isFrozen(read)) return undefined;
	const method = Object.getOwnPropertyDescriptor(read, "captureCurrentProbe");
	if (method === undefined || !("value" in method) || typeof method.value !== "function") return undefined;
	return Reflect.apply(method.value, read, [observation]) as LiveJournalRetirementImageCurrentProbe | undefined;
}

